<Application x:Class="SwitchBoard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SwitchBoard.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/GraphiteTheme.xaml" />
                <ResourceDictionary Source="Localization/Strings.en.xaml" />
                <ResourceDictionary Source="Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" Inverse="True" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style TargetType="Window">
                <Setter Property="Icon" Value="/Assets/switchboard.ico" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
