<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SwitchBoard.LibVlcPlugin</AssemblyName>
    <RootNamespace>SwitchBoard.LibVlcPlugin</RootNamespace>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- This reference exposes only the renderer contract. Private=false keeps
         SwitchBoard.dll out of the optional component package. -->
    <ProjectReference Include="..\SwitchBoard.csproj" Private="false" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <None Include="ComponentManifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
