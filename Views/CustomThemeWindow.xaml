<Window x:Class="SwitchBoard.Views.CustomThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CustomTheme.Title}" Width="620" Height="700" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource CustomTheme.Title}" />
            <TextBlock Margin="0,4,0,16" Style="{StaticResource CaptionText}" Text="{DynamicResource CustomTheme.Subtitle}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource CustomTheme.Colors}" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Colors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                <Button Grid.Column="1" Margin="5,0" Padding="4" Click="ColorButton_OnClick" ToolTip="{DynamicResource CustomTheme.ChooseColor}">
                                    <Border Width="22" Height="22" CornerRadius="5" Background="{Binding PreviewBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                </Button>
                                <TextBox Grid.Column="2" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1" Margin="0,12" Background="{DynamicResource BorderBrush}" />
                <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource CustomTheme.BackgroundImage}" />
                <TextBlock Margin="0,5,0,8" Style="{StaticResource CaptionText}" Text="{Binding BackgroundFileName}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal">
                    <Button Click="ChooseImage_OnClick" Content="{DynamicResource CustomTheme.ChooseImage}" />
                    <Button Margin="8,0,0,0" Click="RemoveImage_OnClick" Content="{DynamicResource CustomTheme.RemoveBackground}" />
                </StackPanel>
                <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource DangerBrush}" Text="{Binding Warning}" TextWrapping="Wrap" />

                <TextBlock Margin="0,15,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource CustomTheme.ImageFit}" />
                <ComboBox ItemsSource="{Binding ImageFitOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                          SelectedValue="{Binding ImageFit, Mode=TwoWay}" />
                <TextBlock Margin="0,15,0,5" Style="{StaticResource EyebrowText}" Text="{DynamicResource CustomTheme.BackgroundOpacity}" />
                <DockPanel><TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Text="{Binding BackgroundOpacityPercent, StringFormat={}{0:0}%}"/><Slider Minimum="0" Maximum="100" Value="{Binding BackgroundOpacityPercent}" /></DockPanel>
                <TextBlock Margin="0,15,0,5" Style="{StaticResource EyebrowText}" Text="{DynamicResource CustomTheme.DarkOverlay}" />
                <DockPanel><TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Text="{Binding DarkOverlayPercent, StringFormat={}{0:0}%}"/><Slider Minimum="0" Maximum="100" Value="{Binding DarkOverlayPercent}" /></DockPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Click="Reset_OnClick" Content="{DynamicResource CustomTheme.Reset}" />
            <Button Grid.Column="2" Click="Cancel_OnClick" Content="{DynamicResource Common.Cancel}" />
            <Button Grid.Column="4" Click="Save_OnClick" Style="{StaticResource AccentButton}" Content="{DynamicResource CustomTheme.Save}" />
        </Grid>
    </Grid>
</Window>
