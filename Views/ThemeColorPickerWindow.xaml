<Window x:Class="SwitchBoard.Views.ThemeColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CustomTheme.ChooseColor}" Width="440" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FF0D0F13" Foreground="#FFF2F4F8">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFF2F4F8" /></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="#FFF2F4F8"/><Setter Property="Background" Value="#FF232833"/><Setter Property="BorderBrush" Value="#FF3A4251"/><Setter Property="CaretBrush" Value="#FFF2F4F8"/><Setter Property="Padding" Value="9,7"/></Style>
        <Style TargetType="Button"><Setter Property="Foreground" Value="#FFF2F4F8"/><Setter Property="Background" Value="#FF232833"/><Setter Property="BorderBrush" Value="#FF3A4251"/><Setter Property="Padding" Value="12,8"/></Style>
        <Style TargetType="Slider"><Setter Property="Foreground" Value="#FF72A7FF"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{DynamicResource CustomTheme.ChooseColor}" />
        <Border x:Name="Preview" Grid.Row="1" Height="64" Margin="0,14,0,14" CornerRadius="8" BorderBrush="#FF596273" BorderThickness="1" />
        <Grid Grid.Row="2" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="A"/><Slider x:Name="Alpha" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Channel_OnValueChanged"/><TextBlock x:Name="AlphaValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
        <Grid Grid.Row="3" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="R"/><Slider x:Name="Red" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Channel_OnValueChanged"/><TextBlock x:Name="RedValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
        <Grid Grid.Row="4" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="G"/><Slider x:Name="Green" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Channel_OnValueChanged"/><TextBlock x:Name="GreenValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
        <Grid Grid.Row="5" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="B"/><Slider x:Name="Blue" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Channel_OnValueChanged"/><TextBlock x:Name="BlueValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
        <StackPanel Grid.Row="6" Margin="0,14,0,0">
            <TextBlock Foreground="#FFAAB2C0" Text="HEX / ARGB" />
            <TextBox x:Name="HexValue" Margin="0,6,0,0" LostFocus="HexValue_OnLostFocus"
                     KeyDown="HexValue_OnKeyDown" TextChanged="HexValue_OnTextChanged" />
            <TextBlock x:Name="ErrorText" Margin="0,5,0,0" Foreground="#FFFF7886" />
        </StackPanel>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Margin="0,0,8,0" Click="Cancel_OnClick" Content="{DynamicResource Common.Cancel}" />
            <Button Click="Save_OnClick" Background="#FF72A7FF" Foreground="#FF08101D" FontWeight="SemiBold" Content="{DynamicResource Common.Confirm}" />
        </StackPanel>
    </Grid>
</Window>
