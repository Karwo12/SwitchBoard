<Window x:Class="SwitchBoard.Views.ProgramPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="880"
        Height="650"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource ProgramPicker.Heading}" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource CaptionText}"
                       Text="{DynamicResource ProgramPicker.Description}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{DynamicResource Common.Search}"
                     ToolTip="{DynamicResource ProgramPicker.SearchHint}" />
            <Button Grid.Column="2"
                    IsEnabled="{Binding IsNotBusy}"
                    Click="QuickSearchButton_OnClick"
                    Content="{DynamicResource ProgramPicker.SearchCommon}" />
            <Button Grid.Column="4"
                    IsEnabled="{Binding IsNotBusy}"
                    Click="ExtendedSearchButton_OnClick"
                    Content="{DynamicResource ProgramPicker.SearchDrive}" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Height="4"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Grid.Column="1"
                    Margin="12,0,0,0"
                    IsEnabled="{Binding IsBusy}"
                    Click="CancelScanButton_OnClick"
                    Content="{DynamicResource ProgramPicker.CancelScan}" />
        </Grid>

        <Border Grid.Row="6" Padding="8" Style="{StaticResource GlassCard}">
            <ListBox x:Name="ProgramList"
                     ItemsSource="{Binding Programs}"
                     SelectedItem="{Binding SelectedProgram, Mode=TwoWay}"
                     SelectionChanged="ProgramList_OnSelectionChanged"
                     MouseDoubleClick="ProgramList_OnMouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,5" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="7,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Width="22"
                                   Height="22"
                                   VerticalAlignment="Top"
                                   Source="{Binding Icon}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource CaptionText}"
                                           Text="{Binding ExecutableName}" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource CaptionText}"
                                           Text="{Binding TargetPath}" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Margin="14,0,0,0"
                                    Padding="8,3"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource SelectionBrush}"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" Text="{DynamicResource ProgramPicker.Running}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource CaptionText}"
                       Text="{Binding StatusText}" />
            <Button Grid.Column="1"
                    Click="CloseButton_OnClick"
                    Content="{DynamicResource Common.Cancel}" />
            <Button x:Name="SelectButton"
                    Grid.Column="3"
                    MinWidth="112"
                    IsEnabled="False"
                    Click="SelectButton_OnClick"
                    Content="{DynamicResource Common.Select}"
                    Style="{StaticResource AccentButton}" />
        </Grid>
    </Grid>
</Window>
