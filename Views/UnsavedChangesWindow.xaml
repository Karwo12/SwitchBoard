<Window x:Class="SwitchBoard.Views.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        MinWidth="430" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Margin="12" Padding="24"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="19">
        <StackPanel>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="15"
                       MaxWidth="560" Foreground="{DynamicResource TextPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="SaveButton" MinWidth="150" Margin="0,0,8,0" IsDefault="True" Click="Save_OnClick" />
            <Button x:Name="DiscardButton" MinWidth="180" Margin="0,0,8,0" Click="Discard_OnClick" />
            <Button x:Name="CancelButton" MinWidth="90" IsCancel="True" Click="Cancel_OnClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
