<UserControl x:Class="SwitchBoard.Views.Panels.PerformancePanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwitchBoard.Controls">
    <UserControl.Resources>
        <Style x:Key="PerformancePanelSectionStyle" TargetType="{x:Type controls:CardSurfaceControl}" BasedOn="{StaticResource CardSurfaceStyle}">
            <Setter Property="Background" Value="{DynamicResource SettingsRowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
            <Setter Property="SurfaceOpacity" Value="0.72" />
        </Style>
        <Style x:Key="PerformancePanelRowStyle" TargetType="{x:Type controls:CardSurfaceControl}" BasedOn="{StaticResource CardSurfaceStyle}">
            <Setter Property="Background" Value="{DynamicResource SettingsRowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
            <Setter Property="SurfaceOpacity" Value="0.58" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="HoverSurfaceBrush" Value="{DynamicResource InteractiveHoverBrush}" /></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Padding="16" Background="{DynamicResource ActivitySurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="2,0,2,10">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Performance.Title}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Subtitle}" />
                <Button HorizontalAlignment="Right" Margin="0,4,0,0" Padding="10,4"
                        Command="{Binding ToggleLiveViewCommand}"
                        Content="{Binding LiveViewToggleText}" />
                <Separator Margin="0,8,0,0" />
            </StackPanel>
            <!-- This is the only vertical scroll viewer: process rows never take ownership of mouse-wheel scrolling. -->
            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" Margin="2,0,2,0" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                <StackPanel>
                    <WrapPanel>
                        <controls:CardSurfaceControl Style="{StaticResource PerformancePanelSectionStyle}" Width="148" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Cpu}" /><TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding PerformanceCpuText}" /></StackPanel></controls:CardSurfaceControl>
                        <controls:CardSurfaceControl Style="{StaticResource PerformancePanelSectionStyle}" Width="218" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Memory}" /><TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding PerformanceMemoryText}" TextTrimming="CharacterEllipsis" /></StackPanel></controls:CardSurfaceControl>
                        <controls:CardSurfaceControl Style="{StaticResource PerformancePanelSectionStyle}" Width="148" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Gpu}" /><TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding PerformanceGpuText}" /></StackPanel></controls:CardSurfaceControl>
                        <controls:CardSurfaceControl Style="{StaticResource PerformancePanelSectionStyle}" Width="148" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Vram}" /><TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding PerformanceVramText}" /></StackPanel></controls:CardSurfaceControl>
                        <controls:CardSurfaceControl Style="{StaticResource PerformancePanelSectionStyle}" Width="188" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Disk}" /><TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding PerformanceDiskText}" /></StackPanel></controls:CardSurfaceControl>
                        <controls:CardSurfaceControl Style="{StaticResource PerformancePanelSectionStyle}" Width="188" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Network}" /><TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding PerformanceDownloadText}" /><TextBlock Style="{StaticResource CaptionText}" Text="{Binding PerformanceUploadText}" /></StackPanel></controls:CardSurfaceControl>
                    </WrapPanel>
                    <TextBlock Margin="0,0,0,10" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.GpuAvailabilityHint}" TextWrapping="Wrap" />

                    <controls:CardSurfaceControl Style="{StaticResource PerformancePanelSectionStyle}" Margin="0,0,0,10" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="{DynamicResource Performance.TopProcesses}" /><TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.ProcessLimitHint}" /></Grid>
                            <Separator Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="145" /><ColumnDefinition Width="62" /><ColumnDefinition Width="98" /><ColumnDefinition Width="88" /><ColumnDefinition Width="88" /><ColumnDefinition Width="62" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                <Button Command="{Binding SortProcessesCommand}" CommandParameter="name" Background="Transparent" BorderThickness="0" Padding="4,2" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Name}" /><TextBlock Margin="4,0,0,0" Style="{StaticResource CaptionText}" Text="{Binding SortNameIndicator}" /></StackPanel></Button>
                                <Button Grid.Column="1" Command="{Binding SortProcessesCommand}" CommandParameter="cpu" Background="Transparent" BorderThickness="0" Padding="4,2"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Cpu}" /><TextBlock Margin="3,0,0,0" Style="{StaticResource CaptionText}" Text="{Binding SortCpuIndicator}" /></StackPanel></Button>
                                <Button Grid.Column="2" Command="{Binding SortProcessesCommand}" CommandParameter="memory" Background="Transparent" BorderThickness="0" Padding="4,2"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Memory}" /><TextBlock Margin="3,0,0,0" Style="{StaticResource CaptionText}" Text="{Binding SortMemoryIndicator}" /></StackPanel></Button>
                                <Button Grid.Column="3" Command="{Binding SortProcessesCommand}" CommandParameter="disk" Background="Transparent" BorderThickness="0" Padding="4,2"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Disk}" /><TextBlock Margin="3,0,0,0" Style="{StaticResource CaptionText}" Text="{Binding SortDiskIndicator}" /></StackPanel></Button>
                                <Button Grid.Column="4" Command="{Binding SortProcessesCommand}" CommandParameter="network" Background="Transparent" BorderThickness="0" Padding="4,2"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Network}" /><TextBlock Margin="3,0,0,0" Style="{StaticResource CaptionText}" Text="{Binding SortNetworkIndicator}" /></StackPanel></Button>
                                <Button Grid.Column="5" Command="{Binding SortProcessesCommand}" CommandParameter="gpu" Background="Transparent" BorderThickness="0" Padding="4,2"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Gpu}" /><TextBlock Margin="3,0,0,0" Style="{StaticResource CaptionText}" Text="{Binding SortGpuIndicator}" /></StackPanel></Button>
                                <Button Grid.Column="6" Command="{Binding SortProcessesCommand}" CommandParameter="vram" Background="Transparent" BorderThickness="0" Padding="4,2"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Vram}" /><TextBlock Margin="3,0,0,0" Style="{StaticResource CaptionText}" Text="{Binding SortVramIndicator}" /></StackPanel></Button>
                            </Grid>
                            <ItemsControl x:Name="ProcessItems" ItemsSource="{Binding PerformanceProcesses}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <controls:CardSurfaceControl Style="{StaticResource PerformancePanelRowStyle}" Margin="0,0,0,5" Padding="8"><StackPanel>
                                        <Button Command="{Binding DataContext.SelectProcessCommand, ElementName=Root}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="145" /><ColumnDefinition Width="62" /><ColumnDefinition Width="98" /><ColumnDefinition Width="88" /><ColumnDefinition Width="88" /><ColumnDefinition Width="62" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="{Binding Indent}" /><Button Width="18" Height="18" Margin="0,0,4,0" Padding="0" Command="{Binding DataContext.ToggleProcessGroupCommand, ElementName=Root}" CommandParameter="{Binding}"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="▼" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button><TextBlock FontWeight="SemiBold" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessName}" /></StackPanel><TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" Text="{Binding CpuText}" /><TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" Text="{Binding MemoryText}" /><TextBlock Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" Text="{Binding DiskText}" /><TextBlock Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" Text="{Binding NetworkText}" /><TextBlock Grid.Column="5" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" Text="{Binding GpuText}" /><TextBlock Grid.Column="6" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" Text="{Binding VramText}" /></Grid></Button>
                                        <Grid Margin="4,10,4,2"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.FullName}" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding ProcessName}" /><TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.ProcessPid}" /><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{Binding ProcessId}" /><TextBlock Grid.Row="1" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.ProcessPath}" /><TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" FontWeight="SemiBold" Text="{Binding DataContext.SelectedPerformanceProcessDetails.ExecutablePath, ElementName=Root}" TextWrapping="Wrap" /><TextBlock Grid.Row="2" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.ProcessPriority}" /><TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{Binding DataContext.SelectedPerformanceProcessDetails.Priority, ElementName=Root}" /><TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Children}" /><TextBlock Grid.Row="2" Grid.Column="3" FontWeight="SemiBold" Text="{Binding ChildCount}" /><TextBlock Grid.Row="3" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.ProcessUsedByProfile}" /><TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" FontWeight="SemiBold" Text="{Binding IsUsedByProfile}" /></Grid>
                                    </StackPanel></controls:CardSurfaceControl>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:CardSurfaceControl>

                    <controls:CardSurfaceControl Style="{StaticResource PerformancePanelSectionStyle}" Margin="0,0,0,10" Padding="14"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{DynamicResource Performance.Measurement}" /><TextBlock Style="{StaticResource CaptionText}" Text="{Binding MeasurementDurationText}" /></StackPanel><Button Grid.Column="1" Margin="6,0,0,0" Padding="10,4" Command="{Binding StartMeasurementCommand}" Content="{DynamicResource Performance.Measurement.Start}" /><Button Grid.Column="2" Margin="6,0,0,0" Padding="10,4" Command="{Binding StopMeasurementCommand}" Content="{DynamicResource Performance.Measurement.Stop}" /><Button Grid.Column="3" Margin="6,0,0,0" Padding="10,4" Command="{Binding ClearMeasurementCommand}" Content="{DynamicResource Performance.Measurement.Clear}" /></Grid><Separator Margin="0,8,0,2" /><ItemsControl Margin="0,10,0,0" ItemsSource="{Binding MeasurementResults}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /><ColumnDefinition Width="84" /><ColumnDefinition Width="100" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="{Binding AverageCpuText}" /><TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" Text="{Binding PeakCpuText}" /><TextBlock Grid.Column="3" Style="{StaticResource CaptionText}" Text="{Binding PeakMemoryText}" /><TextBlock Grid.Column="4" Style="{StaticResource CaptionText}" Text="{Binding DiskTotalText}" /><TextBlock Grid.Column="5" Style="{StaticResource CaptionText}" Text="{Binding NetworkTotalText}" /><TextBlock Grid.Column="6" Style="{StaticResource CaptionText}" Text="{Binding AverageGpuText}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></controls:CardSurfaceControl>

                    <controls:CardSurfaceControl Style="{StaticResource PerformancePanelSectionStyle}" Margin="0,0,0,4" Padding="14"><StackPanel><TextBlock FontWeight="SemiBold" Text="{DynamicResource Performance.SwitchBoardImpact}" /><Separator Margin="0,8,0,2" /><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Cpu}" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SwitchBoardCpuText}" /><TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Memory}" /><TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{Binding SwitchBoardMemoryText}" /><TextBlock Grid.Row="1" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.Gpu}" /><TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="{Binding SwitchBoardGpuText}" /><TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.BackgroundType}" /><TextBlock Grid.Row="1" Grid.Column="3" FontWeight="SemiBold" Text="{Binding CurrentBackgroundKindText}" /><TextBlock Grid.Row="2" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.BackgroundActivity}" /><TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{Binding BackgroundPlaybackStateText}" /><TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource CaptionText}" Text="{DynamicResource Performance.BackgroundQuality}" /><TextBlock Grid.Row="2" Grid.Column="3" FontWeight="SemiBold" Text="{Binding BackgroundQualityText}" /></Grid></StackPanel></controls:CardSurfaceControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
