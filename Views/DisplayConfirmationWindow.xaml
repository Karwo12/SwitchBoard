<Window x:Class="SwitchBoard.Views.DisplayConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource DisplayConfirmation.Title}"
        Width="470" Height="245" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <ContentControl Margin="18" Padding="24" Style="{StaticResource GlassPanel}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                           Text="{DynamicResource DisplayConfirmation.Question}" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Text="{Binding CountdownText}"/>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource CaptionText}"
                           Text="{DynamicResource DisplayConfirmation.TimeoutHint}" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                <Button MinWidth="112" Click="RevertButton_OnClick" Content="{DynamicResource DisplayConfirmation.Revert}"/>
                <Button MinWidth="112" Margin="10,0,0,0" Click="KeepButton_OnClick"
                        Content="{DynamicResource DisplayConfirmation.Keep}" Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>
