<Window x:Class="SwitchBoard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SwitchBoard.Controls"
        xmlns:panels="clr-namespace:SwitchBoard.Views.Panels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="SwitchBoard"
        Width="{Binding WindowWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Height="{Binding WindowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        MinWidth="900"
        MinHeight="500"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowChromeMaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowChromeButtonStyle}">
            <Setter Property="AutomationProperties.Name" Value="{DynamicResource Window.Maximize}" />
            <Setter Property="ToolTip" Value="{DynamicResource Window.Maximize}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="AutomationProperties.Name" Value="{DynamicResource Window.Restore}" />
                    <Setter Property="ToolTip" Value="{DynamicResource Window.Restore}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowChromeCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowChromeButtonStyle}" />

        <Style x:Key="MainNavigationButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopNavigationButtonStyle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource MainNavigationButtonStyle}">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsCategoryButtonStyle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource MainNavigationButtonStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="ProfileFolderListBoxItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileNavigationListBoxItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <!-- The item contains a folder header and, when expanded, a child ListBox.
                 Do not inherit the global ListBoxItem IsMouseOver surface here: it
                 would paint the whole folder whenever any child profile is hovered. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasExecutionError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileNavigationItemChrome" TargetType="ContentControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border x:Name="Surface"
                                    Background="{DynamicResource SettingsRowBackgroundBrush}"
                                    CornerRadius="8"
                                    IsHitTestVisible="False"
                                    Opacity="0.22" />
                            <Border x:Name="HoverSurface"
                                    Background="Transparent"
                                    CornerRadius="8"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Surface" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityTabButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Border x:Name="HoverSurface"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityTab1ButtonStyle" TargetType="Button" BasedOn="{StaticResource ActivityTabButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding ActivityTabIndex}" Value="1"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ActivityTab2ButtonStyle" TargetType="Button" BasedOn="{StaticResource ActivityTabButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding ActivityTabIndex}" Value="2"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="ActivityRowSurfaceStyle" TargetType="{x:Type controls:CardSurfaceControl}" BasedOn="{StaticResource CardSurfaceStyle}">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="HoverSurfaceBrush" Value="{DynamicResource InteractiveHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivityHistoryRowSurfaceStyle" TargetType="{x:Type controls:CardSurfaceControl}" BasedOn="{StaticResource CardSurfaceStyle}">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style x:Key="ActivityHistoryHeaderButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <Grid>
                                <Border x:Name="HoverSurface"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileResultStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Result}" Value="Success"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="Warning"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="Cancelled"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="Error"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionResultStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Result}" Value="success"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="skipped"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="cancelled"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="failed"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ProfileNavigationItemTemplate">
            <ContentControl Margin="5,3"
                            Padding="4,1"
                            Style="{StaticResource ProfileNavigationItemChrome}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Column="0" Grid.RowSpan="2" Width="4" Margin="0,4,2,5" CornerRadius="2" Background="{Binding Color}" />
                    <Path Grid.Column="1" Grid.Row="0" Width="12" Height="12" HorizontalAlignment="Center"
                          Data="{Binding IconPathData}"
                          Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{Binding Color}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Color}" Value="{x:Null}">
                                        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <controls:RenamableListItemControl Grid.Column="2"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding Name}"
                        EditText="{Binding EditName, Mode=TwoWay}"
                        IsEditing="{Binding IsEditing}"
                        BeginEditCommand="{Binding DataContext.BeginProfileRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommitEditCommand="{Binding DataContext.CommitProfileRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CancelEditCommand="{Binding DataContext.CancelProfileRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,-2,0,5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Style="{StaticResource CaptionText}">
                        <Run Text="{Binding Actions.Count, Mode=OneWay}" />
                        <Run Text=" " />
                        <Run Text="{DynamicResource Common.ActionsLower}" />
                    </TextBlock>
                </Grid>
                <Button Grid.Column="1"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        ToolTip="{DynamicResource Tooltip.DeleteProfile}"
                        Style="{StaticResource DangerIconButton}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <Path Width="13"
                                  Height="13"
                                  Data="M2,2 L12,12 M12,2 L2,12"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Style="{StaticResource SemanticStrokeIcon}" />
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Grid.Column="2" Padding="0" Margin="4,0,0,0"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                        Click="ThemeMenuButton_OnClick"
                        ToolTip="{DynamicResource Profile.MoreOptions}"
                        Style="{StaticResource CompactIconButton}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextPrimaryBrush}" />
                        <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextPrimaryBrush}" />
                        <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Closed="ContextMenu_OnClosed"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{DynamicResource Profile.Duplicate}"
                                      Command="{Binding PlacementTarget.Tag.DuplicateProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="{DynamicResource Profile.Export}"
                                      Command="{Binding PlacementTarget.Tag.ExportProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Settings.ProfileColor}">
                                <MenuItem Header="{DynamicResource Settings.AppearanceNone}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{DynamicResource Settings.ProfileColorBlue}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="#4F8EF7" />
                                <MenuItem Header="{DynamicResource Settings.ProfileColorPurple}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="#9B6BFF" />
                                <MenuItem Header="{DynamicResource Settings.ProfileColorGreen}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="#44B78B" />
                                <MenuItem Header="{DynamicResource Settings.ProfileColorOrange}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="#E6953B" />
                                <MenuItem Header="{DynamicResource Settings.ProfileColorRed}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="#D95D63" />
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Settings.ProfileIcon}">
                                <MenuItem Header="{DynamicResource Settings.AppearanceNone}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{DynamicResource Settings.ProfileIconBolt}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="bolt" />
                                <MenuItem Header="{DynamicResource Settings.ProfileIconBriefcase}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="briefcase" />
                                <MenuItem Header="{DynamicResource Settings.ProfileIconGamepad}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="gamepad" />
                                <MenuItem Header="{DynamicResource Settings.ProfileIconMonitor}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="monitor" />
                                <MenuItem Header="{DynamicResource Settings.ProfileIconMoon}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="moon" />
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
            </ContentControl>
        </DataTemplate>

        <Style x:Key="ProfileFolderToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProfileFolderNavigationItemTemplate">
            <Grid Margin="0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl Grid.Row="0"
                                Padding="2,0"
                                Style="{StaticResource ProfileNavigationItemChrome}"
                                controls:ListBoxDragDrop.IsProfileFolderDropTarget="True"
                                controls:ListBoxDragDrop.DropCommand="{Binding DataContext.ReorderDropCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0"
                                  Width="20"
                                  Height="30"
                                  Cursor="Hand"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  Style="{StaticResource ProfileFolderToggleButtonStyle}">
                        <Path Width="9" Height="9"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M2,1 L7,5 L2,9"
                              Fill="Transparent"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeThickness="1.35">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" CenterX="4.5" CenterY="5" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>
                    <Path Grid.Column="1"
                          Width="17"
                          Height="17"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M1,4 H6 L7.5,6 H15 V14 H1 Z"
                          Fill="Transparent"
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeLineJoin="Round"
                          StrokeThickness="1.35" />
                    <controls:RenamableListItemControl Grid.Column="2"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding Name}"
                        EditText="{Binding EditName, Mode=TwoWay}"
                        IsEditing="{Binding IsEditing}"
                        BeginEditCommand="{Binding DataContext.BeginCategoryRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommitEditCommand="{Binding DataContext.CommitCategoryRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CancelEditCommand="{Binding DataContext.CancelCategoryRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                    <Button Grid.Column="3"
                            Margin="4,0,0,0"
                            Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="Ă—"
                            ToolTip="{DynamicResource Tooltip.DeleteCategory}"
                        Style="{StaticResource DangerIconButton}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <Path Width="13"
                                  Height="13"
                                  Data="M2,2 L12,12 M12,2 L2,12"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Style="{StaticResource SemanticStrokeIcon}" />
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                </Grid>
                </ContentControl>
                <ListBox Grid.Row="1"
                         Margin="26,1,0,2"
                         ItemsSource="{Binding VisibleProfiles}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource ProfileNavigationListBoxItemStyle}"
                         ItemTemplate="{StaticResource ProfileNavigationItemTemplate}"
                         SelectionChanged="ProfileList_OnSelectionChanged"
                         SelectedItem="{Binding DataContext.SelectedProfile, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                         controls:ListBoxDragDrop.DragKind="Profile"
                         controls:ListBoxDragDrop.AcceptKinds="Profile"
                         controls:ListBoxDragDrop.DropCommand="{Binding DataContext.ReorderDropCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         controls:ListBoxDragDrop.TargetParentId="{Binding Id}">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.Template>
                        <ControlTemplate TargetType="{x:Type ListBox}">
                            <Border Background="Transparent">
                                <ItemsPresenter />
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <controls:ThemeBackground x:Name="ThemeBackgroundHost"
                                  SourcePath="{DynamicResource CustomBackgroundPath}"
                                  ImageOpacity="{DynamicResource CustomBackgroundOpacity}"
                                  ImageStretch="{DynamicResource CustomBackgroundStretch}"
                                  GifAnimationDirection="{DynamicResource CustomBackgroundGifAnimationDirection}"
                                  GifAnimationSpeed="{DynamicResource CustomBackgroundGifAnimationSpeed}"
                                  VideoPlaybackSpeed="{DynamicResource CustomBackgroundVideoPlaybackSpeed}"
                                  VideoAudioEnabled="{DynamicResource CustomBackgroundVideoAudioEnabled}"
                                  ImageFlipHorizontal="{DynamicResource CustomBackgroundFlipHorizontal}"
                                  ImageFlipVertical="{DynamicResource CustomBackgroundFlipVertical}"
                                  PauseWhenWindowMinimized="{Binding PauseAnimatedBackgroundWhenMinimized}"
                                  PauseWhenWindowInactive="{Binding PauseAnimatedBackgroundWhenInactive}"
                                  PauseDuringProfileExecution="{Binding PauseAnimatedBackgroundDuringProfileExecution}"
                                  IsProfileExecutionActive="{Binding IsProfileExecutionActive}"
                                  PerformanceMode="{Binding BackgroundPerformanceMode}"
                                  GifFrameRateLimit="{Binding GifFrameRateLimit}"
                                  Mp4RendererPreference="{Binding Mp4RendererPreference}" />
        <Grid x:Name="MainVisualOverlay">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        <Border Grid.RowSpan="3" Background="{DynamicResource CustomBackgroundOverlayBrush}" IsHitTestVisible="False" />

        <Grid Grid.Row="0"
              Background="Transparent"
              Panel.ZIndex="1"
              MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
              shell:WindowChrome.IsHitTestVisibleInChrome="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="12,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="False">
                <Image Width="16"
                       Height="16"
                       Margin="0,0,8,0"
                       Source="/Assets/switchboard.ico"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="SwitchBoard" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Stretch"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button AutomationProperties.Name="{DynamicResource Window.Minimize}"
                        Click="MinimizeButton_OnClick"
                        Style="{StaticResource WindowChromeButtonStyle}"
                        ToolTip="{DynamicResource Window.Minimize}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="12"
                          Height="12"
                          Data="M1,9 H11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeEndLineCap="Square"
                          StrokeStartLineCap="Square"
                          StrokeThickness="1.4"
                          Stretch="Uniform" />
                </Button>
                <Button Click="MaximizeButton_OnClick"
                        Style="{StaticResource WindowChromeMaximizeButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Width="12" Height="12">
                        <Path Data="M1,1 H11 V11 H1 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Path Data="M4,1 H11 V8 H9 V3 H4 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Stretch="Uniform" />
                            <Path Data="M1,4 H8 V11 H1 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Stretch="Uniform" />
                        </Grid>
                    </Grid>
                </Button>
                <Button AutomationProperties.Name="{DynamicResource Window.Close}"
                        Click="CloseButton_OnClick"
                        Style="{StaticResource WindowChromeCloseButtonStyle}"
                        ToolTip="{DynamicResource Window.Close}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="12"
                          Height="12"
                          Data="M2,2 L10,10 M10,2 L2,10"
                          StrokeThickness="1.4"
                          Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="26,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ToggleButton x:Name="HomeNavigationButton"
                              AutomationProperties.Name="{DynamicResource Navigation.Home}"
                              AutomationProperties.AutomationId="HomeNavigationButton"
                              Click="HomeNavigationButton_OnClick"
                              IsChecked="True"
                              Style="{StaticResource TopNavigationButtonStyle}"
                              ToolTip="{DynamicResource Navigation.Home}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16"
                              Height="16"
                              Margin="0,0,7,0"
                              Data="M2,8 L9,2 L16,8 V15 H11 V10 H7 V15 H2 Z"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeLineJoin="Round"
                              StrokeThickness="1.4"
                              Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Navigation.Home}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="SystemNavigationButton"
                              AutomationProperties.Name="{DynamicResource Navigation.System}"
                              AutomationProperties.AutomationId="SystemNavigationButton"
                              Click="SystemNavigationButton_OnClick"
                              Style="{StaticResource TopNavigationButtonStyle}"
                              ToolTip="{DynamicResource Navigation.System}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Margin="0,0,7,0"
                              Data="M3,2 H15 V14 H3 Z M6,17 H12 M9,14 V17 M6,5 H12 M6,8 H12 M6,11 H9"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              StrokeThickness="1.4" Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Navigation.System}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="PerformanceNavigationButton"
                              AutomationProperties.Name="{DynamicResource Navigation.Performance}"
                              AutomationProperties.AutomationId="PerformanceNavigationButton"
                              Click="PerformanceNavigationButton_OnClick"
                              Style="{StaticResource TopNavigationButtonStyle}"
                              ToolTip="{DynamicResource Navigation.Performance}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Margin="0,0,7,0"
                              Data="M2,13 L5.5,9.5 L8,11.5 L13.5,5.5 L16,8 M2,16 H16"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              StrokeThickness="1.5" Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Navigation.Performance}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ActivityNavigationButton"
                              AutomationProperties.Name="{DynamicResource Activity.Title}"
                              AutomationProperties.AutomationId="ActivityNavigationButton"
                              Click="ActivityNavigationButton_OnClick"
                              Style="{StaticResource TopNavigationButtonStyle}"
                              ToolTip="{DynamicResource Activity.Title}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16"
                              Height="16"
                              Margin="0,0,7,0"
                              Data="M2,3 H16 M2,8 H16 M2,13 H11 M2,3 V13"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeThickness="1.4"
                              Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Activity.Title}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="SettingsNavigationButton"
                              AutomationProperties.Name="{DynamicResource Settings.Title}"
                              AutomationProperties.AutomationId="SettingsNavigationButton"
                              Click="SettingsNavigationButton_OnClick"
                              Style="{StaticResource TopNavigationButtonStyle}"
                              ToolTip="{DynamicResource Settings.Title}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" Margin="0,0,7,0">
                            <Path Data="M6.2,1.8 L11.8,1.8 L12.5,4.1 C12.9,4.3 13.3,4.5 13.7,4.8 L16,4.1 L18.8,8.9 L17,10.5 C17,11 17,11.4 17,11.9 L18.8,13.5 L16,18.3 L13.7,17.6 C13.3,17.9 12.9,18.1 12.5,18.3 L11.8,20.6 L6.2,20.6 L5.5,18.3 C5.1,18.1 4.7,17.9 4.3,17.6 L2,18.3 L-0.8,13.5 L1,11.9 C1,11.4 1,11 1,10.5 L-0.8,8.9 L2,4.1 L4.3,4.8 C4.7,4.5 5.1,4.3 5.5,4.1 Z"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.2"
                                  Stretch="Uniform" />
                            <Ellipse Width="5" Height="5"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                     StrokeThickness="1.2" />
                        </Grid>
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Settings.Title}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Width="360" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Stretch"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusMessage}"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding StatusMessage}" />
                    <TextBlock HorizontalAlignment="Stretch" TextAlignment="Right" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                <Setter Property="Text" Value="{DynamicResource Common.AllChangesSaved}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Text" Value="{DynamicResource Common.UnsavedChanges}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button MinWidth="92" Margin="0,0,8,0"
                        Command="{Binding UndoCommand}"
                        CommandParameter="button"
                        ToolTip="{DynamicResource Common.UndoTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="17" Height="17" Margin="0,0,7,0" Stretch="Uniform"
                              Style="{StaticResource SemanticStrokeIcon}"
                              Data="M8,4 L3,8 L8,12 M4,8 H11 C15,8 17,10 17,14"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Common.Undo}" />
                    </StackPanel>
                </Button>
                <Button MinWidth="92" Margin="0,0,8,0"
                        Command="{Binding RedoCommand}"
                        ToolTip="{DynamicResource Common.RedoTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="17" Height="17" Margin="0,0,7,0" Stretch="Uniform"
                              Style="{StaticResource SemanticStrokeIcon}"
                              Data="M10,4 L15,8 L10,12 M14,8 H7 C3,8 2,10 2,14"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Common.Redo}" />
                    </StackPanel>
                </Button>
                <Button MinWidth="128"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="17" Height="17" Margin="0,0,7,0" Stretch="Uniform"
                              Data="M2,2 H14 L18,6 V18 H2 Z M5,2 V8 H14 M5,12 H15 V18 H5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" />
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Common.SaveChanges}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="MainContentGrid" Grid.Row="2" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ContentRow" Height="{Binding TopContentRowHeight}" MinHeight="170" />
                <RowDefinition Height="6" />
                <RowDefinition x:Name="ActivityRow" Height="{Binding ActivityContentRowHeight}" MinHeight="{Binding ActivityMinimumHeight}" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250" MaxWidth="320" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="ProfileNavigationContent"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.RowSpan="3"
                            Background="{DynamicResource ProfilesSurfaceBrush}"
                            Style="{StaticResource GlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Panel.Profiles}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource CaptionText}"
                                       Text="{DynamicResource Panel.CategoriesSubtitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding AddProfileCommand}"
                                    ToolTip="{DynamicResource Tooltip.AddProfile}"
                                    Style="{StaticResource GhostIconButton}">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeThickness="1.5"
                                      Data="M7,2 L7,12 M2,7 L12,7" />
                            </Button>
                            <Button Margin="4,0,0,0"
                                    Command="{Binding AddCategoryCommand}"
                                    ToolTip="{DynamicResource Tooltip.AddCategory}"
                                    Style="{StaticResource GhostIconButton}">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.35"
                                      Data="M1,4 H6 L7.5,6 H15 V14 H1 Z M11,8 V12 M9,10 H13" />
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="2" Margin="10,0,0,0"
                                Command="{Binding ImportProfileCommand}"
                                ToolTip="{DynamicResource Profile.Import}"
                                Style="{StaticResource GhostIconButton}">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  Data="M7,1 L7,10 M3.5,6.5 L7,10 L10.5,6.5 M2,13 L12,13" />
                        </Button>
                    </Grid>

                    <controls:SearchBoxControl Grid.Row="1"
                                                Width="246"
                                                Margin="0,8,6,8"
                                                Text="{Binding ProfileSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Grid.Row="2" Padding="0,0,6,0">
                        <Grid>
                            <ListBox MinHeight="34"
                                     ItemsSource="{Binding FilteredRootNavigationItems}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ProfileNavigationListBoxItemStyle}"
                                     SelectedItem="{Binding SelectedRootNavigationItem, Mode=TwoWay}"
                                     controls:ListBoxDragDrop.DragKind="Category"
                                     controls:ListBoxDragDrop.AcceptKinds="Category,Profile"
                                     controls:ListBoxDragDrop.DropCommand="{Binding ReorderDropCommand}"
                                     controls:ListBoxDragDrop.TargetParentId="{Binding RootCategoryId}"
                                     controls:ListBoxDragDrop.IsRootNavigationTarget="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.PanningMode="VerticalOnly"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemTemplateSelector>
                                    <controls:ProfileNavigationItemTemplateSelector
                                        CategoryTemplate="{StaticResource ProfileFolderNavigationItemTemplate}"
                                        ProfileTemplate="{StaticResource ProfileNavigationItemTemplate}" />
                                </ListBox.ItemTemplateSelector>
                                <ListBox.Template>
                                    <ControlTemplate TargetType="{x:Type ListBox}">
                                        <Border Background="Transparent">
                                            <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                          PanningMode="{TemplateBinding ScrollViewer.PanningMode}">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>
                            <StackPanel Visibility="Collapsed">
                            <ListBox ItemsSource="{Binding Categories}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ProfileFolderListBoxItemStyle}"
                                     controls:ListBoxDragDrop.DragKind="Category"
                                     controls:ListBoxDragDrop.AcceptKinds="Profile"
                                     controls:ListBoxDragDrop.DropCommand="{Binding ReorderDropCommand}">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="{x:Type ListBox}">
                                        <Border Background="Transparent">
                                            <ItemsPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Column="0"
                                                              Width="32"
                                                              Height="30"
                                                              Padding="0"
                                                              Background="Transparent"
                                                              BorderThickness="0"
                                                              Cursor="Hand"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                                    <Grid>
                                                        <Path Width="10" Height="10"
                                                              Margin="2,0,0,0"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              Data="M3,2 L7,6 L3,10"
                                                              Fill="Transparent"
                                                              Stroke="{DynamicResource TextSecondaryBrush}"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeThickness="1.3">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="90" CenterX="5" CenterY="6" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <Path Width="16" Height="16"
                                                              Margin="0,0,1,0"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Data="M1,4 H6 L7.5,6 H15 V14 H1 Z"
                                                              Fill="Transparent"
                                                              Stroke="{DynamicResource TextPrimaryBrush}"
                                                              StrokeLineJoin="Round"
                                                              StrokeThickness="1.25" />
                                                    </Grid>
                                                </ToggleButton>
                                                <controls:RenamableListItemControl Grid.Column="1"
                                                    Text="{Binding Name}"
                                                    EditText="{Binding EditName, Mode=TwoWay}"
                                                    IsEditing="{Binding IsEditing}"
                                                    BeginEditCommand="{Binding DataContext.BeginCategoryRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommitEditCommand="{Binding DataContext.CommitCategoryRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CancelEditCommand="{Binding DataContext.CancelCategoryRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                                <Button Grid.Column="2"
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="×"
                                                        ToolTip="{DynamicResource Tooltip.DeleteCategory}"
                                                        Style="{StaticResource DangerIconButton}" />
                                            </Grid>
                                            <ListBox Grid.Row="1"
                                                     Margin="26,1,0,2"
                                                     ItemsSource="{Binding Profiles}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource ProfileNavigationListBoxItemStyle}"
                                                     ItemTemplate="{StaticResource ProfileNavigationItemTemplate}"
                                                     SelectedItem="{Binding DataContext.SelectedProfile, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                     controls:ListBoxDragDrop.DragKind="Profile"
                                                     controls:ListBoxDragDrop.AcceptKinds="Profile"
                                                     controls:ListBoxDragDrop.DropCommand="{Binding DataContext.ReorderDropCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     controls:ListBoxDragDrop.TargetParentId="{Binding Id}">
                                                <ListBox.Style>
                                                    <Style TargetType="ListBox">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.Style>
                                                <ListBox.Template>
                                                    <ControlTemplate TargetType="{x:Type ListBox}">
                                                        <Border Background="Transparent">
                                                            <ItemsPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </ListBox.Template>
                                            </ListBox>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Height="1" Margin="0,5" Background="{DynamicResource BorderBrush}" />
                            <ListBox MinHeight="34"
                                     ItemsSource="{Binding RootProfiles}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ProfileNavigationListBoxItemStyle}"
                                     ItemTemplate="{StaticResource ProfileNavigationItemTemplate}"
                                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                     controls:ListBoxDragDrop.DragKind="Profile"
                                     controls:ListBoxDragDrop.AcceptKinds="Profile"
                                     controls:ListBoxDragDrop.DropCommand="{Binding ReorderDropCommand}"
                                     controls:ListBoxDragDrop.TargetParentId="{Binding RootCategoryId}">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="{x:Type ListBox}">
                                        <Border Background="Transparent">
                                            <ItemsPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ContentControl>

            <ContentControl Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                            Visibility="Collapsed"
                            Background="{DynamicResource CategoriesSurfaceBrush}"
                            Style="{StaticResource GlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Panel.Categories}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource CaptionText}"
                                       Text="{DynamicResource Panel.CategoriesSubtitle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding AddCategoryCommand}"
                                Content="+"
                                ToolTip="{DynamicResource Tooltip.AddCategory}"
                                Style="{StaticResource GhostIconButton}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding Categories}"
                                 controls:ListBoxDragDrop.DragKind="Category"
                                 controls:ListBoxDragDrop.AcceptKinds="Category,Profile"
                                 controls:ListBoxDragDrop.DropCommand="{Binding ReorderDropCommand}"
                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                     <Grid Margin="5,3">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource DangerBrush}" CornerRadius="2">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasExecutionError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        </Border>
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Top" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" Text="!">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasExecutionError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <controls:RenamableListItemControl
                                            Text="{Binding Name}"
                                            EditText="{Binding EditName, Mode=TwoWay}"
                                            IsEditing="{Binding IsEditing}"
                                            BeginEditCommand="{Binding DataContext.BeginCategoryRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommitEditCommand="{Binding DataContext.CommitCategoryRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CancelEditCommand="{Binding DataContext.CancelCategoryRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                        <Button Grid.Column="1"
                                                Margin="5,0,0,0"
                                                Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="×"
                                                ToolTip="{DynamicResource Tooltip.DeleteCategory}"
                                                Style="{StaticResource DangerIconButton}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Categories.Count, Mode=OneWay}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="26"
                                       Foreground="{DynamicResource IconMuted}"
                                       Text="＋" />
                            <TextBlock Margin="0,9,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{DynamicResource Empty.CreateFirstCategory}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ContentControl>

            <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="True" />

            <ContentControl Grid.Row="0" Grid.Column="2" Background="{DynamicResource ProfilesSurfaceBrush}"
                            Visibility="Collapsed"
                            Style="{StaticResource GlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Panel.Profiles}" />
                            <Grid Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="{Binding SelectedCategory.Name}"
                                           Visibility="{Binding SelectedCategory, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="{DynamicResource Panel.SelectCategory}"
                                           Visibility="{Binding SelectedCategory, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding AddProfileCommand}"
                                Content="+"
                                ToolTip="{DynamicResource Tooltip.AddProfile}"
                                Style="{StaticResource GhostIconButton}" />
                        <Button Grid.Column="2" Margin="4,0,0,0"
                                Command="{Binding ImportProfileCommand}"
                                ToolTip="{DynamicResource Profile.Import}"
                                Style="{StaticResource GhostIconButton}">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  Data="M7,1 L7,10 M3.5,6.5 L7,10 L10.5,6.5 M2,13 L12,13" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding Profiles}"
                                 controls:ListBoxDragDrop.DragKind="Profile"
                                 controls:ListBoxDragDrop.AcceptKinds="Profile"
                                 controls:ListBoxDragDrop.DropCommand="{Binding ReorderDropCommand}"
                                 controls:ListBoxDragDrop.TargetParentId="{Binding SelectedCategory.Id}"
                                 SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExecuting}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsRestoring}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger>
                                        <DataTrigger Binding="{Binding HasExecutionError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Column="0" Grid.RowSpan="2" Width="4" Margin="0,4,2,5" CornerRadius="2" Background="{Binding Color}" />
                                            <Path Grid.Column="1" Grid.Row="0" Width="12" Height="12" HorizontalAlignment="Center"
                                                  Data="{Binding IconPathData}"
                                                  Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{Binding Color}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Color}" Value="{x:Null}">
                                                                <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <controls:RenamableListItemControl
                                                Grid.Column="2"
                                                Text="{Binding Name}"
                                                EditText="{Binding EditName, Mode=TwoWay}"
                                                IsEditing="{Binding IsEditing}"
                                                BeginEditCommand="{Binding DataContext.BeginProfileRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommitEditCommand="{Binding DataContext.CommitProfileRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CancelEditCommand="{Binding DataContext.CancelProfileRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,-2,0,5" Style="{StaticResource CaptionText}">
                                                <Run Text="{Binding Actions.Count, Mode=OneWay}" />
                                                <Run Text=" " />
                                                <Run Text="{DynamicResource Common.ActionsLower}" />
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="1"
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="×"
                                                ToolTip="{DynamicResource Tooltip.DeleteProfile}"
                                                Style="{StaticResource DangerIconButton}" />
                                        <Button Grid.Column="2" Margin="4,0,0,0"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Click="ThemeMenuButton_OnClick"
                                                ToolTip="{DynamicResource Profile.MoreOptions}"
                                                Style="{StaticResource CompactIconButton}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextPrimaryBrush}" />
                                                <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextPrimaryBrush}" />
                                                <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu Closed="ContextMenu_OnClosed"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{DynamicResource Profile.Duplicate}"
                                                              Command="{Binding PlacementTarget.Tag.DuplicateProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="{DynamicResource Profile.Export}"
                                                              Command="{Binding PlacementTarget.Tag.ExportProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="{DynamicResource Settings.ProfileColor}">
                                                        <MenuItem Header="{DynamicResource Settings.AppearanceNone}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="{DynamicResource Settings.ProfileColorBlue}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="#4F8EF7" />
                                                        <MenuItem Header="{DynamicResource Settings.ProfileColorPurple}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="#9B6BFF" />
                                                        <MenuItem Header="{DynamicResource Settings.ProfileColorGreen}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="#44B78B" />
                                                        <MenuItem Header="{DynamicResource Settings.ProfileColorOrange}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="#E6953B" />
                                                        <MenuItem Header="{DynamicResource Settings.ProfileColorRed}" Command="{Binding PlacementTarget.Tag.SetProfileColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="#D95D63" />
                                                    </MenuItem>
                                                    <MenuItem Header="{DynamicResource Settings.ProfileIcon}">
                                                        <MenuItem Header="{DynamicResource Settings.AppearanceNone}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="{DynamicResource Settings.ProfileIconBolt}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="bolt" />
                                                        <MenuItem Header="{DynamicResource Settings.ProfileIconBriefcase}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="briefcase" />
                                                        <MenuItem Header="{DynamicResource Settings.ProfileIconGamepad}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="gamepad" />
                                                        <MenuItem Header="{DynamicResource Settings.ProfileIconMonitor}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="monitor" />
                                                        <MenuItem Header="{DynamicResource Settings.ProfileIconMoon}" Command="{Binding PlacementTarget.Tag.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="moon" />
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   Text="{DynamicResource Empty.NoProfiles}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Profiles.Count, Mode=OneWay}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </ContentControl>

            <GridSplitter Grid.Row="0" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Visibility="Collapsed"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="True" />

            <GridSplitter x:Name="ActivityLayoutSplitter" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                          Visibility="Collapsed"
                          Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeNS" ShowsPreview="False"
                          DragCompleted="ActivityLayoutSplitter_OnDragCompleted"
                          MouseDoubleClick="ActivityLayoutSplitter_OnMouseDoubleClick" />

            <controls:ActionEditorControl x:Name="ActionEditor" Grid.RowSpan="3" Grid.Column="4" />

            <panels:ActivityPanel x:Name="ActivityContent" Grid.Row="0" Grid.RowSpan="3"
                                  Grid.Column="0" Grid.ColumnSpan="5" Margin="0"
                                  Visibility="Collapsed" Panel.ZIndex="2"
                                  NavigationRequested="ActivityContent_OnNavigationRequested" />


            <panels:SystemPanel x:Name="SystemContent" Grid.Row="0" Grid.RowSpan="3"
                                Grid.Column="0" Grid.ColumnSpan="5" Margin="0"
                                Visibility="Collapsed" Panel.ZIndex="2"
                                DataContext="{Binding SystemPanel}" />

            <panels:PerformancePanel x:Name="PerformanceContent" Grid.Row="0" Grid.RowSpan="3"
                                     Grid.Column="0" Grid.ColumnSpan="5" Margin="0"
                                     Visibility="Collapsed" Panel.ZIndex="2"
                                     DataContext="{Binding PerformancePanel}" />
        </Grid>

        <Grid x:Name="SettingsWorkspace"
              Grid.Row="2"
              Margin="16,0,16,16"
              HorizontalAlignment="Stretch">
            <ContentControl x:Name="SettingsContent"
                            Padding="18"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Visibility="Collapsed"
                            Style="{StaticResource GlassPanel}">
            <Grid x:Name="SettingsWorkspaceContentHost"
                  HorizontalAlignment="Stretch">
                <Grid x:Name="SettingsWorkspaceContent"
                      Width="{Binding ActualWidth, ElementName=SettingsWorkspaceContentHost}"
                      MaxWidth="1100"
                      HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="190" MaxWidth="210" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Title}" />
                    <Border Height="1" Margin="0,14,0,12" Background="{DynamicResource BorderBrush}" />

                    <ToggleButton x:Name="SettingsProfileCategoryButton"
                                  AutomationProperties.Name="{DynamicResource Settings.Profile}"
                                  Click="SettingsProfileCategoryButton_OnClick"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Style="{StaticResource SettingsCategoryButtonStyle}"
                                  ToolTip="{DynamicResource Settings.Profile}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18" Margin="0,0,10,0">
                                <Ellipse Width="6" Height="6"
                                         VerticalAlignment="Top"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                         StrokeThickness="1.3" />
                                <Path Data="M2,15 C2.7,11.8 5.1,10 8,10 C10.9,10 13.3,11.8 14,15"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.3" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Settings.Profile}" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="SettingsGeneralCategoryButton"
                                  AutomationProperties.Name="{DynamicResource Settings.General}"
                                  Click="SettingsGeneralCategoryButton_OnClick"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Style="{StaticResource SettingsCategoryButtonStyle}"
                                  ToolTip="{DynamicResource Settings.General}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Margin="0,0,10,0"
                                  Data="M3,13 L13,3 L16,6 L6,16 L2,17 Z M11,5 L14,8"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.3"
                                  Stretch="Uniform" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Settings.General}" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="SettingsInterfaceCategoryButton"
                                  AutomationProperties.Name="{DynamicResource Settings.Interface}"
                                  AutomationProperties.AutomationId="SettingsInterfaceCategoryButton"
                                  Click="SettingsInterfaceCategoryButton_OnClick"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Style="{StaticResource SettingsCategoryButtonStyle}"
                                  ToolTip="{DynamicResource Settings.Interface}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Margin="0,0,10,0"
                                  Data="M2,3 H14 M2,8 H14 M2,13 H14 M5,1 V5 M11,6 V10 M7,11 V15"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.25"
                                  Stretch="Uniform" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Settings.Interface}" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="SettingsThemesCategoryButton"
                                  AutomationProperties.Name="{DynamicResource Settings.Themes}"
                                  Click="SettingsThemesCategoryButton_OnClick"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Style="{StaticResource SettingsCategoryButtonStyle}"
                                  ToolTip="{DynamicResource Settings.Themes}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Margin="0,0,10,0"
                                  Data="M8,2 C4.2,2 1,4.7 1,8.2 C1,11.5 3.4,14 6.5,14 H8 C9.1,14 9.7,15.3 9,16.1 C8.3,16.9 8.9,18 10,18 C13.2,18 16,15.1 16,11.5 C16,6.2 12.4,2 8,2 Z M5,8 A1,1 0 1 0 5.01,8 M8,5 A1,1 0 1 0 8.01,5 M11,8 A1,1 0 1 0 11.01,8"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.2"
                                  Stretch="Uniform" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Settings.Themes}" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="SettingsDataCategoryButton"
                                  AutomationProperties.Name="{DynamicResource Settings.Data}"
                                  Click="SettingsDataCategoryButton_OnClick"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Style="{StaticResource SettingsCategoryButtonStyle}"
                                  ToolTip="{DynamicResource Settings.Data}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Margin="0,0,10,0"
                                  Data="M3,4 C3,2.3 13,2.3 13,4 C13,5.7 3,5.7 3,4 M3,4 V8 C3,9.7 13,9.7 13,8 V4 M3,8 V12 C3,13.7 13,13.7 13,12 V8"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.25"
                                  Stretch="Uniform" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Settings.Data}" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="SettingsDiagnosticsCategoryButton"
                                  AutomationProperties.Name="{DynamicResource Settings.Diagnostics}"
                                  Click="SettingsDiagnosticsCategoryButton_OnClick"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Style="{StaticResource SettingsCategoryButtonStyle}"
                                  ToolTip="{DynamicResource Settings.Diagnostics}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Margin="0,0,10,0"
                                  Data="M8,1 L14,3 V7.5 C14,11.2 11.5,14 8,15 C4.5,14 2,11.2 2,7.5 V3 Z M8,5 V9 M8,12 V12.1"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.25"
                                  Stretch="Uniform" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Settings.Diagnostics}" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <Grid Grid.Column="2"
                      HorizontalAlignment="Stretch"
                      MaxWidth="760">
                    <ScrollViewer x:Name="SettingsCategoryScrollViewer"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="SettingsFormContainer"
                              Style="{StaticResource SettingsContentContainer}">
                            <StackPanel x:Name="ProfileSettingsPanel"
                                        Visibility="Visible">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Profile}" />
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}"
                                        Visibility="{Binding SelectedProfile, Converter={StaticResource NotNullToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource Settings.ProfileBehavior}" />
                                        <ComboBox x:Name="SettingsProfileSelector"
                                                  Width="280"
                                                  Margin="0,7,0,0"
                                                  HorizontalAlignment="Left"
                                                  DisplayMemberPath="SettingsDisplayName"
                                                  ItemsSource="{Binding AllProfiles}"
                                                  MaxDropDownHeight="320"
                                                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />
                                        <CheckBox Margin="0,9,0,0"
                                                  IsChecked="{Binding SelectedProfile.CloseSwitchBoardAfterSuccessfulCompletion, Mode=TwoWay}">
                                            <TextBlock Text="{DynamicResource Editor.CloseAfterProfile}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox Margin="0,7,0,0"
                                                  IsChecked="{Binding SelectedProfile.CloseSwitchBoardAfterSuccessfulRestore, Mode=TwoWay}">
                                            <TextBlock Text="{DynamicResource Editor.CloseAfterRestore}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Margin="0,18,0,0" Style="{StaticResource EyebrowText}"
                                                   Text="{DynamicResource Settings.ProfileAppearance}" />
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CaptionText}"
                                                           Text="{DynamicResource Settings.ProfileColor}" />
                                                <ComboBox Margin="0,4,0,0"
                                                          ItemsSource="{Binding ProfileColorOptions}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding SelectedProfile.Color, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource CaptionText}"
                                                           Text="{DynamicResource Settings.ProfileIcon}" />
                                                <ComboBox Margin="0,4,0,0"
                                                          ItemsSource="{Binding ProfileIconOptions}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding SelectedProfile.Icon, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                            </StackPanel>

                            <StackPanel x:Name="GeneralSettingsPanel"
                                        Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.General}" />
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource Settings.Language}" />
                                        <ComboBox Margin="0,7,0,0"
                                                  ItemsSource="{Binding LanguageOptions}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}" />
                                        <CheckBox Margin="0,16,0,0" IsChecked="{Binding IsLaunchAtStartup, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.LaunchAtStartup}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.LaunchAtStartupHint}" TextWrapping="Wrap" />
                                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.StartMinimizedToTray}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.StartMinimizedToTrayHint}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,16,0,0" Style="{StaticResource EyebrowText}"
                                                   Text="{DynamicResource Settings.CloseBehavior}" />
                                        <ComboBox Margin="0,7,0,0" ItemsSource="{Binding CloseBehaviorOptions}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding CloseBehavior, Mode=TwoWay}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.TrayHint}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,16,0,0" Style="{StaticResource EyebrowText}"
                                                   Text="{DynamicResource Settings.Updates}" />
                                        <CheckBox Margin="0,7,0,0" IsChecked="{Binding CheckForUpdatesAtStartup, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.CheckUpdatesAtStartup}" />
                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.CurrentVersion}" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding ApplicationVersion}" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.LatestVersion}" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding LatestDetectedVersion}" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.LastUpdateCheck}" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding LastUpdateCheckText}" />
                                        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding CheckUpdatesCommand}"
                                                Content="{DynamicResource Settings.CheckUpdates}" />
                                        <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionText}" Text="{Binding UpdateStatusText}" TextWrapping="Wrap" />
                                        <Button Margin="0,7,0,0" HorizontalAlignment="Left" Command="{Binding OpenLatestReleaseCommand}"
                                                Content="{DynamicResource Settings.OpenRelease}" />
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding RememberLastView, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.RememberLastView}" />
                                        <CheckBox Margin="0,12,0,0" IsChecked="{Binding WarnBeforeClosingWithUnsavedChanges, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.WarnUnsaved}" />
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource Settings.About}" />
                                        <TextBlock Margin="0,5,0,0" Text="SwitchBoard" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="{Binding ApplicationVersion}" />
                                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenRepositoryCommand}" Content="{Binding RepositoryUrl}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="{Binding DataDirectoryPath}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                            </StackPanel>

                            <StackPanel x:Name="InterfaceSettingsPanel"
                                        Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Interface}" />
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding ShowCurrentActionState, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.ShowCurrentActionState}" />
                                        <TextBlock Margin="0,16,0,0" Style="{StaticResource EyebrowText}"
                                                   Text="{DynamicResource Settings.Density}" />
                                        <ComboBox Margin="0,7,0,0" ItemsSource="{Binding InterfaceDensityOptions}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding InterfaceDensity, Mode=TwoWay}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.DensityHint}" TextWrapping="Wrap" />
                                        <CheckBox Margin="0,16,0,0" IsChecked="{Binding ShowCardDetails, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.ShowCardDetails}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.ShowCardDetailsHint}" TextWrapping="Wrap" />
                                        <CheckBox Margin="0,16,0,0" AutomationProperties.AutomationId="AutoFitWindowToBackgroundCheckBox"
                                                  IsChecked="{Binding AutoFitWindowToBackground, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.AutoFitWindowToBackground}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.AutoFitWindowToBackgroundHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}"
                                                   Text="{DynamicResource Settings.BackgroundPerformance}" />
                                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding PauseAnimatedBackgroundWhenMinimized, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.PauseBackgroundWhenMinimized}" />
                                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding PauseAnimatedBackgroundWhenInactive, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.PauseBackgroundWhenInactive}" />
                                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding PauseAnimatedBackgroundDuringProfileExecution, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.PauseBackgroundDuringProfile}" />
                                        <TextBlock Margin="0,14,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.BackgroundPerformanceMode}" />
                                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding BackgroundPerformanceModeOptions}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding BackgroundPerformanceMode, Mode=TwoWay}" />
                                        <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.GifFrameRate}" />
                                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding GifFrameRateLimitOptions}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding GifFrameRateLimit, Mode=TwoWay}" />
                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.Mp4AudioDisabledByDefault}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}"
                                                   Text="{DynamicResource Settings.Mp4Renderer}" />
                                        <ComboBox Margin="0,7,0,0" ItemsSource="{Binding Mp4RendererPreferenceOptions}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Mp4RendererPreference, Mode=TwoWay}" />
                                        <TextBlock Margin="0,16,0,0" Style="{StaticResource EyebrowText}"
                                                   Text="{DynamicResource Settings.LibVlcOptionalEngine}" />
                                        <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.LibVlcDescription}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,0" Text="{Binding LibVlcComponentStatusText}" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{Binding LibVlcDownloadSizeText}" />
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Button Command="{Binding InstallLibVlcCommand}"
                                                    Content="{DynamicResource Settings.LibVlcInstall}" />
                                            <Button Margin="8,0,0,0" Command="{Binding RemoveLibVlcCommand}"
                                                    Content="{DynamicResource Settings.LibVlcRemove}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{Binding LibVlcOperationStatusText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                            </StackPanel>

                            <StackPanel x:Name="ThemeSettingsPanel"
                                        Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Themes}" />
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowText}"
                                           Text="{DynamicResource Settings.Appearance}" />
                                <TextBlock Margin="0,7,0,6"
                                           Style="{StaticResource CaptionText}"
                                           Text="{DynamicResource Settings.Theme}" />
                                <ListBox ItemsSource="{Binding ThemeOptions}"
                                         SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}"
                                         controls:ListBoxDragDrop.DragKind="Theme"
                                         controls:ListBoxDragDrop.AcceptKinds="Theme"
                                         controls:ListBoxDragDrop.DropCommand="{Binding ReorderDropCommand}"
                                         controls:ListBoxDragDrop.SuppressSelectionOnDrag="True"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="{x:Type ListBox}">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2" MinHeight="30">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Width="8" Height="12" Margin="0,0,6,0"
                                                          Fill="{DynamicResource TextTertiaryBrush}"
                                                          Data="M1,2 H3 V4 H1 Z M5,2 H7 V4 H5 Z M1,5 H3 V7 H1 Z M5,5 H7 V7 H5 Z M1,8 H3 V10 H1 Z M5,8 H7 V10 H5 Z"
                                                          Cursor="SizeAll"
                                                          controls:ListBoxDragDrop.IsDragHandle="True"
                                                          ToolTip="{DynamicResource Settings.ThemeReorder}" />
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                                             Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Margin="3,0,7,0" VerticalAlignment="Center" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="2" Padding="0"
                                                        DataContext="{Binding}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Click="ThemeMenuButton_OnClick" ToolTip="{DynamicResource CustomTheme.Manage}"
                                                        Style="{StaticResource CompactIconButton}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextPrimaryBrush}" />
                                                        <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextPrimaryBrush}" />
                                                        <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                    <Button.ContextMenu>
                                                        <ContextMenu Closed="ContextMenu_OnClosed"
                                                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="{DynamicResource CustomTheme.DuplicateAndEdit}"
                                                                      Tag="duplicate"
                                                                      Click="ThemeMenuItem_OnClick"
                                                                      CommandParameter="{Binding Id}">
                                                                <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBuiltIn}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource CustomTheme.Edit}"
                                                                      Tag="edit"
                                                                      Click="ThemeMenuItem_OnClick"
                                                                      CommandParameter="{Binding Id}">
                                                                <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource CustomTheme.Duplicate}"
                                                                      Tag="duplicate"
                                                                      Click="ThemeMenuItem_OnClick"
                                                                      CommandParameter="{Binding Id}">
                                                                <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource CustomTheme.Rename}"
                                                                      Tag="rename"
                                                                      Click="ThemeMenuItem_OnClick"
                                                                      CommandParameter="{Binding Id}">
                                                                <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource CustomTheme.Export}"
                                                                      Tag="export"
                                                                      Click="ThemeMenuItem_OnClick"
                                                                      CommandParameter="{Binding Id}">
                                                                <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="{DynamicResource CustomTheme.Delete}"
                                                                      Tag="delete"
                                                                      Click="ThemeMenuItem_OnClick"
                                                                      CommandParameter="{Binding Id}">
                                                                <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Margin="0,9,0,0" Command="{Binding AddThemeCommand}" Content="{DynamicResource CustomTheme.AddWithPlus}" />
                                <Button Margin="0,6,0,0" Command="{Binding ImportThemeCommand}" Content="{DynamicResource CustomTheme.Import}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding OpenThemeFolderCommand}"
                                        Content="{DynamicResource Settings.OpenThemeFolder}" />
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                            </StackPanel>

                            <StackPanel x:Name="DataSettingsPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Data}" />
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource Settings.Backup}" />
                                        <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.BackupHint}" TextWrapping="Wrap" />
                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                            <Button Command="{Binding ExportBackupCommand}" Content="{DynamicResource Settings.ExportBackup}" />
                                            <Button Margin="8,0,0,0" Command="{Binding ImportBackupCommand}" Content="{DynamicResource Settings.ImportBackup}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <Button Command="{Binding CreateManagedBackupCommand}" Content="{DynamicResource Settings.CreateBackupNow}" />
                                            <Button Margin="8,0,0,0" Command="{Binding OpenBackupsFolderCommand}" Content="{DynamicResource Settings.OpenBackupFolder}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.LastBackup}" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding LastSuccessfulBackupText}" />
                                        <ListBox Margin="0,8,0,0" ItemsSource="{Binding ManagedBackups}"
                                                 SelectedItem="{Binding SelectedManagedBackup, Mode=TwoWay}"
                                                 MaxHeight="160">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource CaptionText}"
                                                                   Text="{Binding CreatedAtUtc, StringFormat={}{0:g}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding RestoreManagedBackupCommand}"
                                                Content="{DynamicResource Settings.RestoreBackup}" />
                                        <CheckBox Margin="0,12,0,0" IsChecked="{Binding CreateBackupOnExit, Mode=TwoWay}"
                                                  Content="{DynamicResource Settings.CreateBackupOnExit}" />
                                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenDataFolderCommand}"
                                                Content="{DynamicResource Settings.OpenDataFolder}" />
                                        <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.BackupThemeAssetHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource Settings.AutomaticBackup}" />
                                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding AutomaticBackupEnabled, Mode=TwoWay}" Content="{DynamicResource Settings.EnableAutomaticBackup}" />
                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionText}" Text="{DynamicResource Settings.BackupRetention}" />
                                        <TextBox Width="90" Margin="0,4,0,0" HorizontalAlignment="Left" Text="{Binding AutomaticBackupCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource Settings.HistoryManagement}" />
                                        <TextBlock Margin="0,7,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.HistoryRetention}" />
                                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding ActivityHistoryRetentionOptions}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding HistoryRetentionDays, Mode=TwoWay}" />
                                        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding ClearPersistentHistoryCommand}"
                                                Content="{DynamicResource Settings.ClearHistory}" />
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource Settings.Reset}" />
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding ResetSettingsCommand}" Content="{DynamicResource Settings.ResetSettings}" />
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding ResetAllDataCommand}" Content="{DynamicResource Settings.ResetAll}" />
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                            </StackPanel>

                            <StackPanel x:Name="DiagnosticsSettingsPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Diagnostics}" />
                                <controls:CardSurfaceControl Style="{StaticResource SettingsSectionCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource Settings.Version}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding ApplicationVersion}" />
                                        <TextBlock Margin="0,14,0,0" Style="{StaticResource EyebrowText}" Text="{DynamicResource Settings.DataFolder}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding DataDirectoryPath}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,14,0,0" Style="{StaticResource EyebrowText}" Text="{DynamicResource Settings.LogFolder}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding LogsDirectoryPath}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource Settings.LogRetentionDescription}" TextWrapping="Wrap" />
                                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                            <Button Command="{Binding OpenLogsFolderCommand}" Content="{DynamicResource Settings.OpenLogFolder}" />
                                            <Button Margin="8,0,0,0" Command="{Binding ClearLogsCommand}" Content="{DynamicResource Settings.ClearLogs}" />
                                        </StackPanel>
                                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding CopyDiagnosticsCommand}"
                                                Content="{DynamicResource Settings.CopyDiagnostics}" />
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Button Command="{Binding ExportDiagnosticsCommand}" Content="{DynamicResource Settings.ExportDiagnostics}" />
                                            <Button Margin="8,0,0,0" Command="{Binding ExportHistoryCommand}" Content="{DynamicResource Settings.ExportHistory}" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:CardSurfaceControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
                </Grid>
            </Grid>
            </ContentControl>
        </Grid>
        </Grid>
    </Grid>
</Window>
