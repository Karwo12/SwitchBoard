<Window x:Class="SwitchBoard.Views.PowerPlanPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="680" Height="500" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource PowerPlanPicker.Heading}"/>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="{DynamicResource PowerPlanPicker.Description}"/>
        </StackPanel>
        <Border Grid.Row="2" Padding="8" Style="{StaticResource GlassCard}">
            <Grid>
                <ListBox x:Name="PlanList" ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                         SelectionChanged="PlanList_OnSelectionChanged" MouseDoubleClick="PlanList_OnMouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="7,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/><TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="{Binding GuidText}"/></StackPanel>
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{DynamicResource PowerPlanPicker.Active}">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"><ProgressBar Width="220" Height="4" IsIndeterminate="True"/><TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionText}" Text="{DynamicResource PowerPlanPicker.Loading}"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="{Binding StatusText}"/>
            <Button Grid.Column="1" Click="CancelButton_OnClick" Content="{DynamicResource Common.Cancel}"/>
            <Button x:Name="SelectButton" Grid.Column="3" MinWidth="112" IsEnabled="False" Click="SelectButton_OnClick" Content="{DynamicResource Common.Select}" Style="{StaticResource AccentButton}"/>
        </Grid>
    </Grid>
</Window>
