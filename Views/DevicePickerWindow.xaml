<Window x:Class="SwitchBoard.Views.DevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="780" Height="510" MinWidth="600" MinHeight="360" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="SearchBox" TextChanged="SearchBox_OnTextChanged" />
        <ListView x:Name="DeviceList" Grid.Row="2" MouseDoubleClick="DeviceList_OnMouseDoubleClick">
            <ListView.View><GridView>
                <GridViewColumn Header="{DynamicResource Picker.Name}" Width="300" DisplayMemberBinding="{Binding FriendlyName}"/>
                <GridViewColumn Header="{DynamicResource Picker.Class}" Width="120" DisplayMemberBinding="{Binding DeviceClass}"/>
                <GridViewColumn Header="{DynamicResource Picker.State}" Width="90" DisplayMemberBinding="{Binding Status}"/>
                <GridViewColumn Header="{DynamicResource Picker.InstanceId}" Width="220" DisplayMemberBinding="{Binding InstanceId}"/>
            </GridView></ListView.View>
        </ListView>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Content="{DynamicResource Common.Cancel}" IsCancel="True"/>
            <Button Content="{DynamicResource Common.Select}" IsDefault="True" Click="Select_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
