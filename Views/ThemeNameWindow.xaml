<Window x:Class="SwitchBoard.Views.ThemeNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CustomTheme.Rename}" Width="430" Height="225" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FF0D0F13" Foreground="#FFF2F4F8">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFF2F4F8" /></Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFF2F4F8"/><Setter Property="Background" Value="#FF232833"/>
            <Setter Property="BorderBrush" Value="#FF3A4251"/><Setter Property="CaretBrush" Value="#FFF2F4F8"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFF2F4F8"/><Setter Property="Background" Value="#FF232833"/>
            <Setter Property="BorderBrush" Value="#FF3A4251"/><Setter Property="Padding" Value="12,8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{DynamicResource CustomTheme.Rename}" />
        <TextBlock Grid.Row="1" Margin="0,12,0,6" Foreground="#FFAAB2C0" Text="{DynamicResource CustomTheme.ThemeName}" />
        <TextBox x:Name="NameBox" Grid.Row="2" />
        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,6,0,0" Foreground="#FFFF7886" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Click="Cancel_OnClick" Content="{DynamicResource Common.Cancel}" />
            <Button Click="Save_OnClick" Background="#FF72A7FF" Foreground="#FF08101D" FontWeight="SemiBold" Content="{DynamicResource CustomTheme.SaveChanges}" />
        </StackPanel>
    </Grid>
</Window>
