<Window x:Class="SwitchBoard.Views.ThemeNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CustomTheme.Rename}" Width="430" Height="225" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource DialogTitle}" Text="{DynamicResource CustomTheme.Rename}" />
        <TextBlock Grid.Row="1" Margin="0,12,0,6" Style="{StaticResource CaptionText}" Text="{DynamicResource CustomTheme.ThemeName}" />
        <TextBox x:Name="NameBox" Grid.Row="2" />
        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,6,0,0" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Click="Cancel_OnClick" Content="{DynamicResource Common.Cancel}" />
            <Button Click="Save_OnClick" Style="{StaticResource AccentButton}" Content="{DynamicResource CustomTheme.SaveChanges}" />
        </StackPanel>
    </Grid>
</Window>
