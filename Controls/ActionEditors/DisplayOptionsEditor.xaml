<UserControl x:Class="SwitchBoard.Controls.ActionEditors.DisplayOptionsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,8,0,0">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="display.configure"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Style="{StaticResource ActionEditorSectionHeader}" Text="{DynamicResource Advanced.DisplayOptions}" />
        <Border Style="{DynamicResource SettingsRowBorderStyle}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.SkipDisplayConfirmation}" TextWrapping="Wrap" />
                <CheckBox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding SkipDisplayConfirmation}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
