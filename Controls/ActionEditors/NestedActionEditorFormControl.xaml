<UserControl x:Class="SwitchBoard.Controls.ActionEditors.NestedActionEditorFormControl"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Top"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwitchBoard.Controls"
             xmlns:editors="clr-namespace:SwitchBoard.Controls.ActionEditors">
                    <StackPanel>
                    <editors:NestedActionNameEditor />

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="program.run"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Target}" /><TextBox Grid.Column="1" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Arguments}" /><TextBox Grid.Column="1" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ProcessTarget}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProcessTargetModes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProcessTargetMode}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Priority}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProcessPriorities}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProcessPriority}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.MemoryPriority}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProcessMemoryPriorities}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProcessMemoryPriority}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.PerformanceMode}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProcessPerformanceModes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProcessPerformanceMode}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.WaitForProcessStart}" /><CheckBox Grid.Column="1" HorizontalAlignment="Center" IsChecked="{Binding WaitForProcessStart}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.MaximumProcessWait}" /><TextBox Grid.Column="1" Text="{Binding ProcessStartWaitSeconds}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="process.configure"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ProcessOperation}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProcessOperations}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProcessOperation}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ProcessName}" /><TextBox Grid.Column="1" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Priority}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProcessPriorities}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProcessPriority}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.MemoryPriority}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProcessMemoryPriorities}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProcessMemoryPriority}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.PerformanceMode}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProcessPerformanceModes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProcessPerformanceMode}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="display.configure"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectedDisplay}" /><TextBox Grid.Column="1" Text="{Binding DisplayMonitorName}" IsReadOnly="True" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Resolution}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDisplayResolutions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedDisplayResolution}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.RefreshRate}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDisplayRefreshRates}" SelectedItem="{Binding DisplayRefreshRate}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="audio.configure"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectOutput}" /><TextBox Grid.Column="1" Text="{Binding AudioOutputDeviceName}" IsReadOnly="True" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectInput}" /><TextBox Grid.Column="1" Text="{Binding AudioInputDeviceName}" IsReadOnly="True" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><StackPanel><CheckBox IsChecked="{Binding SetDefaultMultimedia}" Content="{DynamicResource ActionEditor.DefaultDevice}" /><CheckBox Margin="0,7,0,0" IsChecked="{Binding SetDefaultCommunications}" Content="{DynamicResource ActionEditor.DefaultCommunications}" /></StackPanel></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Volume}" /><TextBox Grid.Column="1" Text="{Binding VolumePercent}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="device.setState"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectDevice}" /><TextBox Grid.Column="1" Text="{Binding DeviceFriendlyName}" IsReadOnly="True" /></Grid></Border>
                        <TextBlock Margin="0,0,0,6" Text="{Binding DeviceInstanceId}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceInstanceId}" />
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.DesiredState}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDeviceStates}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding DeviceState}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="service.setState"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectedService}" /><TextBox Grid.Column="1" Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.DesiredState}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableServiceStates}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding DesiredServiceState}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ServiceStartupType}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableServiceStartupTypes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding DesiredServiceStartupType}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="power.setPlan"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectedPowerPlan}" /><TextBox Grid.Column="1" Text="{Binding PowerPlanGuid, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="wait.processStart"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding Type}" Value="wait.processExit"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding Type}" Value="wait.window"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ProcessName}" /><TextBox Grid.Column="1" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ExecutablePath}" /><TextBox Grid.Column="1" Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="delay"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.DelayDuration}" /><TextBox Grid.Column="1" Text="{Binding DelaySeconds}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="script.run"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ScriptPath}" /><TextBox Grid.Column="1" Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="profile.run"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Profile}" /><TextBox Grid.Column="1" Text="{Binding TargetProfileId, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="notification.show"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Message}" /><TextBox Grid.Column="1" Text="{Binding NotificationMessage, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="condition.if"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.If}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableConditions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ConditionType}" /></Grid></Border>
                        <Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Value}" /><TextBox Grid.Column="1" Text="{Binding ConditionValue, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                        <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="{DynamicResource ActionEditor.Then}" />
                        <Button HorizontalAlignment="Left" Command="{Binding DataContext.OpenThenActionPickerCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource Editor.AddAction}" />
                                                    <ItemsControl ItemsSource="{Binding ThenActions}"><ItemsControl.ItemTemplate><DataTemplate><controls:NestedActionEditorControl Action="{Binding}" DeleteCommand="{Binding DataContext.DeleteNestedActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" MoveUpCommand="{Binding DataContext.MoveNestedActionUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" MoveDownCommand="{Binding DataContext.MoveNestedActionDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="{DynamicResource ActionEditor.Otherwise}" />
                        <Button HorizontalAlignment="Left" Command="{Binding DataContext.OpenElseActionPickerCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource Editor.AddAction}" />
                        <ItemsControl ItemsSource="{Binding ElseActions}"><ItemsControl.ItemTemplate><DataTemplate><controls:NestedActionEditorControl Action="{Binding}" DeleteCommand="{Binding DataContext.DeleteNestedActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" MoveUpCommand="{Binding DataContext.MoveNestedActionUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" MoveDownCommand="{Binding DataContext.MoveNestedActionDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SupportsRestore}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Border Margin="0,8,0,0" Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.RestoreBehavior}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableRestoreBehaviors}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding RestoreBehaviorId}" /></Grid></Border>
                    </StackPanel>
                </StackPanel>
</UserControl>
