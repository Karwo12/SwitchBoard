<UserControl x:Class="SwitchBoard.Controls.ActionEditors.ProgramActionEditor"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Top"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwitchBoard.Controls"
             xmlns:editors="clr-namespace:SwitchBoard.Controls.ActionEditors"
            >
    <StackPanel><StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="program.run"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><editors:ActionNameEditor /><Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Target}" /><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="2" Command="{Binding DataContext.BrowseProgramCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.Browse}" /><Button Grid.Column="4" Command="{Binding DataContext.FindProgramCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.FindProgram}" /></Grid></Grid></Border><Grid Visibility="Collapsed" Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Grid.Row="0" Margin="0,0,0,6" Orientation="Horizontal"><TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.Arguments}" /><TextBlock Margin="5,0,0,0" Style="{StaticResource CaptionText}" Text="ⓘ"><TextBlock.ToolTip><StackPanel MaxWidth="330"><TextBlock Text="{DynamicResource ActionEditor.ArgumentsHelp}" TextWrapping="Wrap" /><TextBlock Margin="0,5,0,0" Text="{DynamicResource ActionEditor.ArgumentsExample}" TextWrapping="Wrap" /></StackPanel></TextBlock.ToolTip></TextBlock></StackPanel><TextBox Grid.Row="1" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource ActionEditor.ArgumentsHelp}" /><Button Grid.Row="1" Grid.Column="2" Command="{Binding DataContext.SelectArgumentsCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectArguments}" /></Grid></StackPanel></StackPanel>
</UserControl>
