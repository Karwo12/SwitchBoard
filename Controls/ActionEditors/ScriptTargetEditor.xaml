<UserControl x:Class="SwitchBoard.Controls.ActionEditors.ScriptTargetEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwitchBoard.Controls">
    <StackPanel Margin="0,8,0,0">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="script.run"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Style="{StaticResource ActionEditorSectionHeader}" Text="{DynamicResource Advanced.ScriptTargetProcess}" />
        <TextBlock Margin="0,0,0,8" Style="{StaticResource CaptionText}" Text="{DynamicResource Advanced.ScriptTargetProcessHelp}" TextWrapping="Wrap" />
        <Border Style="{DynamicResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ProcessName}" />
            <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Command="{Binding DataContext.SelectProcessCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectProcess}" />
            </Grid>
        </Grid></Border>
        <Border Margin="0,4,0,0" Style="{DynamicResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ExecutablePath}" /><TextBox Grid.Column="1" Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
        </Grid></Border>
        <Border Margin="0,4,0,0" Style="{DynamicResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.WaitForProcessStart}" /><CheckBox Grid.Column="1" HorizontalAlignment="Center" IsChecked="{Binding WaitForProcessStart}" />
        </Grid></Border>
        <Border Margin="0,4,0,0" Style="{DynamicResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.MaximumProcessWait}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Width="80" Text="{Binding ProcessStartWaitSeconds}" /><TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Common.Seconds}" /></StackPanel>
        </Grid></Border>
    </StackPanel>
</UserControl>
