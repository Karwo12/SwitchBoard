<UserControl x:Class="SwitchBoard.Controls.ActionEditors.SystemActionEditor"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Top"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwitchBoard.Controls"
             xmlns:editors="clr-namespace:SwitchBoard.Controls.ActionEditors"
            >
    <StackPanel><StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="display.configure"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><editors:ActionNameEditor /><Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectedDisplay}" /><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding DisplayMonitorName}" IsReadOnly="True" /><Button Grid.Column="2" Command="{Binding DataContext.SelectDisplayCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectDisplay}" /></Grid></Grid></Border><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="{Binding DisplayDeviceId}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayDeviceId}" /><Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Resolution}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDisplayResolutions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedDisplayResolution, Mode=TwoWay}" /></Grid></Border><Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.RefreshRate}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDisplayRefreshRates}" SelectedItem="{Binding DisplayRefreshRate, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} Hz}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid></Border><TextBlock Margin="0,9,0,0" Style="{StaticResource CaptionText}" Text="{DynamicResource ActionEditor.DisplaySafetyHint}" TextWrapping="Wrap" /></StackPanel>
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="service.setState"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><editors:ActionNameEditor /><Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectedService}" /><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding ServiceName}" IsReadOnly="True" /><Button Grid.Column="2" Command="{Binding DataContext.SelectServiceCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectService}" /></Grid></Grid></Border><Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ServiceRuntimeState}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableServiceStates}" DisplayMemberPath="DisplayName" SelectedValue="{Binding DesiredServiceState, Mode=TwoWay}" SelectedValuePath="Value" /></Grid></Border><Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ServiceStartupType}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableServiceStartupTypes}" DisplayMemberPath="DisplayName" SelectedValue="{Binding DesiredServiceStartupType, Mode=TwoWay}" SelectedValuePath="Value" /></Grid></Border><TextBlock Margin="0,9,0,0" Style="{StaticResource CaptionText}" Text="{DynamicResource ActionEditor.AdminHint}" TextWrapping="Wrap" /></StackPanel>
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="power.setPlan"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><editors:ActionNameEditor /><Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectedPowerPlan}" /><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding PowerPlanName}" IsReadOnly="True" /><Button Grid.Column="2" Command="{Binding DataContext.SelectPowerPlanCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectPowerPlan}" /></Grid></Grid></Border><TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionText}" Text="{Binding PowerPlanGuid}" /></StackPanel>
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="audio.configure"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><editors:ActionNameEditor /><Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectOutput}" /><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox IsReadOnly="True" Text="{Binding AudioOutputDeviceName}" /><Button Grid.Column="2" Command="{Binding DataContext.SelectAudioOutputCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectOutput}" /></Grid></Grid></Border><Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectInput}" /><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox IsReadOnly="True" Text="{Binding AudioInputDeviceName}" /><Button Grid.Column="2" Command="{Binding DataContext.SelectAudioInputCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectInput}" /></Grid></Grid></Border><Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8"><StackPanel><CheckBox IsChecked="{Binding SetDefaultMultimedia}" Content="{DynamicResource ActionEditor.DefaultDevice}" /><CheckBox Margin="0,7,0,0" IsChecked="{Binding SetDefaultCommunications}" Content="{DynamicResource ActionEditor.DefaultCommunications}" /></StackPanel></Border><Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions><StackPanel><CheckBox IsChecked="{Binding ChangeVolume}" Content="{DynamicResource ActionEditor.Volume}" /><CheckBox Margin="0,7,0,0" IsChecked="{Binding ChangeMute}" Content="{DynamicResource ActionEditor.ChangeMute}" /></StackPanel><StackPanel Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox IsEnabled="{Binding ChangeVolume}" Text="{Binding VolumePercent}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="%" /><CheckBox Grid.Column="2" IsChecked="{Binding Mute}" Content="{DynamicResource ActionEditor.Mute}" /></Grid></StackPanel></Grid></Border></StackPanel>
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="device.setState"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><editors:ActionNameEditor /><Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.SelectDevice}" /><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox IsReadOnly="True" Text="{Binding DeviceFriendlyName}" /><Button Grid.Column="2" Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectDevice}" /></Grid></Grid></Border><TextBlock Margin="0,0,0,4" Text="{Binding DeviceInstanceId}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceInstanceId}" /><Border Style="{StaticResource SettingsRowBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.DesiredState}" /><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDeviceStates}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding DeviceState}" /></Grid></Border><TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionText}" Text="{DynamicResource ActionEditor.DeviceWarning}" TextWrapping="Wrap" /></StackPanel></StackPanel>
</UserControl>
