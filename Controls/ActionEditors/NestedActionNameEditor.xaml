<UserControl x:Class="SwitchBoard.Controls.ActionEditors.NestedActionNameEditor"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Top"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,6">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.FriendlyName}" />
            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
    </Border>
</UserControl>
