<UserControl x:Class="SwitchBoard.Controls.SearchBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SwitchBoard.Controls"
             x:Name="Root"
             MinHeight="36"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="SearchBoxTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalContentAlignment="Left"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.TextAlignment="Left"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="InputChrome" Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledInputForeground}" />
                                <Setter TargetName="InputChrome" Property="Background" Value="{DynamicResource DisabledInputBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <TextBox x:Name="SearchTextBox"
                 Style="{StaticResource SearchBoxTextBoxStyle}"
                 local:TextBoxEnterCommitBehavior.CommitOnEnter="False"
                 Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Padding="36,7,34,7"
                 HorizontalContentAlignment="Left"
                 TextAlignment="Left"
                 PreviewKeyDown="SearchTextBox_OnPreviewKeyDown"
                 AutomationProperties.Name="{DynamicResource Common.SearchPlaceholder}"
                 ToolTip="{DynamicResource Common.SearchPlaceholder}" />

        <Path Width="15" Height="15"
              Margin="12,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Stretch="Uniform"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="1.5"
              StrokeLineJoin="Round"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              IsHitTestVisible="False"
              Data="M6.5,1.5 A5,5 0 1 0 6.5,11.5 A5,5 0 1 0 6.5,1.5 M10,10 L14,14" />

        <TextBlock Margin="39,0,34,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Opacity="0.9"
                   IsHitTestVisible="False"
                   Text="{DynamicResource Common.SearchPlaceholder}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasText, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Button x:Name="ClearButton"
                Width="28"
                Height="28"
                MinHeight="28"
                Margin="0,0,4,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ToolTip="{DynamicResource Common.ClearSearch}"
                AutomationProperties.Name="{DynamicResource Common.ClearSearch}"
                Click="ClearButton_OnClick">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DangerIconButton}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasText, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Path Width="12" Height="12"
                  Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="M2,2 L12,12 M12,2 L2,12" />
        </Button>
    </Grid>
</UserControl>
