<UserControl x:Class="SwitchBoard.Controls.NestedActionEditorControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwitchBoard.Controls"
             xmlns:editors="clr-namespace:SwitchBoard.Controls.ActionEditors"
             DataContext="{Binding Action, ElementName=Root}">
    <Border Margin="0,3" Padding="10" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="7">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Margin="0,0,9,0" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}"
                          ToolTip="{DynamicResource Tooltip.EnableAction}" />
                <Button Grid.Column="1" Padding="0" HorizontalContentAlignment="Stretch"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding DataContext.ToggleActionExpandedCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}"
                        CommandParameter="{Binding}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{Binding Summary}" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="2" Margin="8,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource DangerBrush}" Text="{Binding ValidationMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ValidationLevel}" Value="Error"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding ValidationLevel}" Value="Warning"><Setter Property="Visibility" Value="Visible" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="3" Width="28" Height="28" Padding="0" Content="×"
                        Style="{StaticResource DangerIconButton}" Command="{Binding DeleteCommand, ElementName=Root}"
                        CommandParameter="{Binding}" ToolTip="{DynamicResource Tooltip.RemoveAction}" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Width="28" Height="28" Padding="0" Content="↑" Command="{Binding MoveUpCommand, ElementName=Root}"
                            CommandParameter="{Binding}" ToolTip="{DynamicResource Editor.MoveUp}" />
                    <Button Width="28" Height="28" Padding="0" Content="↓" Command="{Binding MoveDownCommand, ElementName=Root}"
                            CommandParameter="{Binding}" ToolTip="{DynamicResource Editor.MoveDown}" />
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource DangerBrush}" Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ValidationLevel}" Value="Error"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding ValidationLevel}" Value="Warning"><Setter Property="Visibility" Value="Visible" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Margin="0,9,0,0" Padding="10" Background="{DynamicResource BackgroundBrush}" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                    <editors:NestedActionEditorFormControl />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
