<UserControl x:Name="Root" x:Class="SwitchBoard.Controls.ActionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwitchBoard.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="700">
    <UserControl.Resources>
        <Style x:Key="SettingsRowBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsRowBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </UserControl.Resources>
    <ContentControl Padding="24,22,24,4" Background="{DynamicResource ProfileEditorSurfaceBrush}"
                    Style="{StaticResource GlassPanel}">
        <Grid>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="34"
                           Foreground="{DynamicResource IconMuted}"
                           Text="◇" />
                <TextBlock Margin="0,12,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Empty.SelectProfile}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource CaptionText}"
                           Text="{DynamicResource Empty.SelectProfileHint}" />
            </StackPanel>

            <Grid Visibility="{Binding SelectedProfile, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="0" />
                    <RowDefinition Height="Auto" />
                    <!-- Reserve a compact footer below the separator so the action list never resizes. -->
                    <RowDefinition Height="48" MinHeight="0" />
                </Grid.RowDefinitions>

                <Grid Height="100" VerticalAlignment="Top" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="134" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="146" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Panel.ProfileEditor}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{DynamicResource Panel.ProfileEditorSubtitle}" />
                        <TextBlock Height="16" Margin="0,5,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding RestoreNoticeText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RestoreNoticeText}" />
                        <Button Margin="0,6,0,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="{DynamicResource DangerBrush}"
                                Content="{Binding RunAvailabilityMessage}"
                                Command="{Binding NavigateToValidationErrorCommand}"
                                Visibility="{Binding HasRunValidationIssue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="134"
                            Height="36"
                            Command="{Binding RunProfileCommand}"
                            ToolTip="{Binding RunAvailabilityMessage}"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Setter Property="Tag" Value="{DynamicResource Execution.RunProfile}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfileRunning}" Value="True">
                                        <Setter Property="Tag" Value="{DynamicResource Execution.RunningButton}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Margin="0,0,7,0" Stretch="Uniform" Data="M3,2 L15,8.5 L3,15 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Width="146" Height="36" Command="{Binding RestoreProfileCommand}"
                            ToolTip="{Binding RestorePreviewText}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Margin="0,0,7,0" Stretch="Uniform"
                                  Style="{StaticResource SemanticStrokeIcon}"
                                  Data="M5,6 A6,6 0 1 1 4,13 M5,6 H1 M5,6 V2"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding RestoreButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5" Width="30" Height="30" Padding="0" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasPendingRestore, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding DiscardPendingRestoreCommand}"
                            Content="×"
                            FontSize="16"
                            ToolTip="{DynamicResource Restore.DiscardTooltip}" />
                    <Border Grid.Column="6" Width="82" Height="32"
                            Padding="8,5"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Style="{StaticResource GlassCard}">
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionText}">
                            <Run Text="{Binding SelectedProfile.Actions.Count, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{DynamicResource Common.ActionsLower}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,7" Style="{StaticResource EyebrowText}"
                                   Text="{DynamicResource Editor.NewActionType}" />
                        <Button x:Name="ActionPickerButton" MinWidth="170" HorizontalContentAlignment="Left"
                                Command="{Binding ToggleActionPickerCommand}"
                                Content="{DynamicResource Editor.AddAction}" />
                        <Popup PlacementTarget="{Binding ElementName=ActionPickerButton}"
                               Placement="Bottom" VerticalOffset="6" HorizontalOffset="0"
                               AllowsTransparency="True" PopupAnimation="Slide" StaysOpen="False"
                               IsOpen="{Binding IsActionPickerOpen, Mode=TwoWay}"
                               Opened="ActionPicker_OnOpened">
                            <Border Width="500" MaxHeight="500" Padding="14"
                                    Style="{StaticResource PopupSurface}">
                                <DockPanel>
                                    <TextBox x:Name="ActionPickerSearchBox" DockPanel.Dock="Top" Margin="0,0,0,10"
                                             Text="{Binding ActionPickerSearch, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource Editor.SearchActions}" PreviewKeyDown="ActionPickerSearch_OnPreviewKeyDown" />
                                    <TextBlock Margin="0,12,0,4" Text="{DynamicResource Editor.NoActionsFound}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FilteredActionTypes.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ActionPickerView}">
                                            <ItemsControl.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="4,12,4,4"
                                                                       Style="{StaticResource EyebrowText}"
                                                                       FontSize="10"
                                                                       Opacity="0.72"
                                                                       Text="{Binding Name}" />
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ItemsControl.GroupStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="4,1"
                                                            Command="{Binding DataContext.SelectActionTypeCommand, Source={x:Reference Root}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="MinHeight" Value="30" />
                                                                <Setter Property="Padding" Value="10,6" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="4" Height="1" Margin="0,0,0,10"
                        Background="{DynamicResource BorderBrush}" />

                <Grid Grid.Row="5">
                    <ListBox x:Name="ActionList"
                             MinHeight="0"
                             VerticalAlignment="Stretch"
                             ItemsSource="{Binding SelectedProfile.Actions}"
                             controls:ListBoxDragDrop.DragKind="Action"
                             controls:ListBoxDragDrop.AcceptKinds="Action"
                             controls:ListBoxDragDrop.DropCommand="{Binding ReorderDropCommand}"
                             controls:ListBoxDragDrop.TargetParentId="{Binding SelectedProfile.Id}"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="ActionList_OnPreviewMouseWheel"
                             PreviewKeyDown="ActionList_OnPreviewKeyDown"
                             RequestBringIntoView="ActionList_OnRequestBringIntoView"
                             SelectedItem="{Binding SelectedAction, Mode=TwoWay}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" Style="{StaticResource GlassCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Margin="0,0,13,0"
                                                      IsChecked="{Binding IsEnabled}"
                                                      ToolTip="{DynamicResource Tooltip.EnableAction}" />
                                            <Button Grid.Column="1"
                                                    controls:ListBoxDragDrop.IsDragHandle="True"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.ToggleActionExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Click="ActionHeader_OnClick"
                                                    Cursor="Hand"
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    AutomationProperties.ItemStatus="{Binding IsExpanded}"
                                                    ToolTip="{Binding Type}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Text="{Binding Summary}" />
                                                        <TextBlock Margin="0,2,0,0" Text="{Binding CurrentStatusText}"
                                                                   ToolTip="{Binding CurrentStatusTooltip}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="12,0,5,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="18"
                                                               Foreground="{DynamicResource TextTertiaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#x203A;" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="&#x2304;" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="2" Width="30" Height="30" Padding="0" Margin="8,0,0,0"
                                                    Style="{StaticResource GhostIconButton}"
                                                    ToolTip="{DynamicResource Tooltip.MoreOptions}"
                                                    Click="ActionOverflow_OnClick">
                                                <Path Width="4" Height="16" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"
                                                      Data="M8,1 A2,2 0 1 0 8,5 A2,2 0 1 0 8,1 M8,6 A2,2 0 1 0 8,10 A2,2 0 1 0 8,6 M8,11 A2,2 0 1 0 8,15 A2,2 0 1 0 8,11" />
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{DynamicResource Editor.TestAction}"
                                                                  Command="{Binding DataContext.TestActionCommand, Source={x:Reference Root}}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="{DynamicResource Editor.DuplicateAction}"
                                                                  Command="{Binding DataContext.DuplicateActionCommand, Source={x:Reference Root}}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="{DynamicResource Editor.UndoActionTest}"
                                                                  Command="{Binding DataContext.UndoSingleActionTestCommand, Source={x:Reference Root}}"
                                                                  IsEnabled="{Binding DataContext.CanUndoSingleActionTest, Source={x:Reference Root}}" />
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Editor.DeleteAction}"
                                                                  Command="{Binding DataContext.DeleteActionCommand, Source={x:Reference Root}}"
                                                                  CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource DangerBrush}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>

                                        <TextBlock Margin="31,6,0,0" Foreground="{DynamicResource DangerBrush}"
                                                   Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ValidationLevel}" Value="Valid"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ValidationLevel}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Margin="31,13,0,0"
                                                Padding="13"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                    <Setter Property="MaxHeight" Value="0" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="IsHitTestVisible" Value="True" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="1"
                                                                                         Duration="0:0:0.16" />
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                         From="0"
                                                                                         To="1800"
                                                                                         Duration="0:0:0.16">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="0"
                                                                                         Duration="0:0:0.14" />
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                         From="1800"
                                                                                         To="0"
                                                                                         Duration="0:0:0.14">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseIn" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                            <Grid>
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="program.run">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.ProgramNameOptional}" />
                                                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.Target}" />
                                                            <Grid Grid.Column="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="2"
                                                                Command="{Binding DataContext.BrowseProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{DynamicResource ActionEditor.Browse}" />
                                                        <Button Grid.Column="4"
                                                                Command="{Binding DataContext.FindProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{DynamicResource ActionEditor.FindProgram}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                     <Grid Visibility="Collapsed" Margin="0,11,0,0">
                                                         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                             <StackPanel Grid.Row="0" Margin="0,0,0,6" Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.Arguments}" />
                                                                <TextBlock Margin="5,0,0,0" Style="{StaticResource CaptionText}" Text="ⓘ">
                                                                    <TextBlock.ToolTip><StackPanel MaxWidth="330"><TextBlock Text="{DynamicResource ActionEditor.ArgumentsHelp}" TextWrapping="Wrap"/><TextBlock Margin="0,5,0,0" Text="{DynamicResource ActionEditor.ArgumentsExample}" TextWrapping="Wrap"/></StackPanel></TextBlock.ToolTip>
                                                                </TextBlock>
                                                            </StackPanel>
                                                              <TextBox Grid.Row="1" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource ActionEditor.ArgumentsHelp}" />
                                                              <Button Grid.Row="1" Grid.Column="2" Command="{Binding DataContext.SelectArgumentsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectArguments}" />
                                                     </Grid>
                                                </StackPanel>

                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Type}" Value="display.configure"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.FriendlyName}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,11,0,0" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectDisplayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectDisplay}" />
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.SelectedDisplay}" />
                                                    <TextBox Text="{Binding DisplayMonitorName}" IsReadOnly="True" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="{Binding DisplayDeviceId}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayDeviceId}" />
                                                    <Grid Margin="0,11,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel><TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.Resolution}"/><ComboBox ItemsSource="{Binding AvailableDisplayResolutions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedDisplayResolution, Mode=TwoWay}"/></StackPanel>
                                                        <StackPanel Grid.Column="2"><TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.RefreshRate}"/><ComboBox ItemsSource="{Binding AvailableDisplayRefreshRates}" SelectedItem="{Binding DisplayRefreshRate, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} Hz}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                                                    </Grid>
                                                    <TextBlock Margin="0,9,0,0" Style="{StaticResource CaptionText}" Text="{DynamicResource ActionEditor.DisplaySafetyHint}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="process.setState">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.FriendlyName}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,11,0,0"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{DynamicResource ActionEditor.SelectProcess}" />
                                                    <Grid Margin="0,11,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.ProcessName}" />
                                                            <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.ExecutablePath}" />
                                                            <TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.DesiredState}" />
                                                    <ComboBox ItemsSource="{Binding AvailableProcessStates}"
                                                              DisplayMemberPath="DisplayName"
                                                              SelectedValue="{Binding DesiredProcessState, Mode=TwoWay}"
                                                              SelectedValuePath="Value" />
                                                    <TextBlock Margin="0,9,0,0" Style="{StaticResource CaptionText}"
                                                               Text="{DynamicResource ActionEditor.ProcessMultipleHint}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionText}"
                                                               Text="{DynamicResource ActionEditor.AdminHint}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Type}" Value="service.setState"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.FriendlyName}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,11,0,0" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectService}" />
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.SelectedService}" />
                                                    <TextBox Text="{Binding ServiceName}" IsReadOnly="True" />
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.ServiceRuntimeState}" />
                                                    <ComboBox ItemsSource="{Binding AvailableServiceStates}" DisplayMemberPath="DisplayName"
