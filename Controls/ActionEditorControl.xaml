<UserControl x:Name="Root" x:Class="SwitchBoard.Controls.ActionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwitchBoard.Controls"
             xmlns:editors="clr-namespace:SwitchBoard.Controls.ActionEditors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="700"
             PreviewKeyDown="ActionEditor_OnPreviewKeyDown">
    <ContentControl Padding="24,22,24,4" Background="{DynamicResource ProfileEditorSurfaceBrush}"
                    Style="{StaticResource GlassPanel}">
        <Grid>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="34"
                           Foreground="{DynamicResource IconMuted}"
                           Text="◇" />
                <TextBlock Margin="0,12,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Empty.SelectProfile}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource CaptionText}"
                           Text="{DynamicResource Empty.SelectProfileHint}" />
                                                         </StackPanel>

            <Grid Visibility="{Binding SelectedProfile, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="0" />
                    <RowDefinition Height="Auto" />
                    <!-- Reserve a compact footer below the separator so the action list never resizes. -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="48" MinHeight="0" />
                </Grid.RowDefinitions>

                <Grid Height="80" VerticalAlignment="Top" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="134" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedProfileBreadcrumb, Mode=OneWay}">
                            <Run Text="{DynamicResource Panel.ProfileEditor}" />
                            <Run Text=" - " />
                            <Run Text="{Binding SelectedProfileBreadcrumb, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{DynamicResource Panel.ProfileEditorSubtitle}" />
                        <TextBlock Height="16" Margin="0,5,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding RestoreNoticeText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RestoreNoticeText}" />
                        <TextBlock Height="16" Margin="0,3,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding PreflightSummary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PreflightSummary}" />
                        <Button Margin="0,6,0,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="{DynamicResource DangerBrush}"
                                Content="{Binding RunAvailabilityMessage}"
                                Command="{Binding NavigateToValidationErrorCommand}"
                                Visibility="{Binding HasRunValidationIssue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="134"
                             Height="36"
                             Command="{Binding RunProfileCommand}"
                             Click="RunProfile_OnClick"
                             ToolTip="{Binding RunAvailabilityMessage}"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Setter Property="Tag" Value="{DynamicResource Execution.RunProfile}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfileRunning}" Value="True">
                                        <Setter Property="Tag" Value="{DynamicResource Execution.RunningButton}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Margin="0,0,7,0" Stretch="Uniform" Data="M3,2 L15,8.5 L3,15 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="3" Width="148" Height="36" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                                <Setter Property="Opacity" Value="0.55" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPendingRestore}" Value="True"><Setter Property="Opacity" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsRestoreRunning}" Value="True"><Setter Property="Opacity" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="114" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Width="114" Height="34" Padding="5,6"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                             Command="{Binding DataContext.RestoreProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             IsEnabled="{Binding HasPendingRestore}"
                            ToolTip="{Binding RestorePreviewText}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Margin="0,0,7,0" Stretch="Uniform"
                                  Style="{StaticResource SemanticStrokeIcon}"
                                  Data="M5,6 A6,6 0 1 1 4,13 M5,6 H1 M1,6 L4,3 M1,6 L4,9"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding RestoreButtonText}" />
                        </StackPanel>
                    </Button>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Text="|" />
                    <Button Grid.Column="2"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.DiscardPendingRestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip="{DynamicResource Restore.DiscardTooltip}"
                            Style="{StaticResource CompactIconButton}">
                        <Path Width="12" Height="12" Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M2,2 L10,10 M10,2 L2,10" />
                    </Button>
                        </Grid>
                    </Border>
                    <Border Grid.Column="5" Width="82" Height="32"
                            Padding="8,5"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Style="{StaticResource GlassCard}">
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionText}">
                            <Run Text="{Binding SelectedProfile.Actions.Count, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{DynamicResource Common.ActionsLower}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Button x:Name="ActionPickerButton" MinWidth="170" HorizontalContentAlignment="Left"
                                Command="{Binding ToggleActionPickerCommand}"
                                Click="ActionPickerButton_OnClick"
                                Content="{DynamicResource Editor.AddAction}" />
                        <Popup x:Name="ActionPickerPopup" PlacementTarget="{Binding ElementName=ActionPickerButton}"
                               Placement="Bottom" VerticalOffset="6" HorizontalOffset="0"
                               AllowsTransparency="True" PopupAnimation="Slide" StaysOpen="False"
                               IsOpen="{Binding IsActionPickerOpen, Mode=TwoWay}"
                               Opened="ActionPicker_OnOpened">
                            <Border Width="500" MaxHeight="500" Padding="14"
                                    Style="{StaticResource PopupSurface}">
                                <DockPanel>
                                    <TextBox x:Name="ActionPickerSearchBox" DockPanel.Dock="Top" Margin="0,0,0,10"
                                             Text="{Binding ActionPickerSearch, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource Editor.SearchActions}" PreviewKeyDown="ActionPickerSearch_OnPreviewKeyDown" />
                                    <TextBlock Margin="0,12,0,4" Text="{DynamicResource Editor.NoActionsFound}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FilteredActionTypes.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ActionPickerView}">
                                            <ItemsControl.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="4,12,4,4"
                                                                       Style="{StaticResource EyebrowText}"
                                                                       FontSize="10"
                                                                       Opacity="0.72"
                                                                       Text="{Binding Name}" />
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ItemsControl.GroupStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="4,1"
                                                            Command="{Binding DataContext.SelectActionTypeCommand, Source={x:Reference Root}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="MinHeight" Value="30" />
                                                                <Setter Property="Padding" Value="10,6" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="4" Height="1" Margin="0,0,0,10"
                        Background="{DynamicResource BorderBrush}" />

                <Grid Grid.Row="5">
                    <ListBox x:Name="ActionList"
                             MinHeight="0"
                             VerticalAlignment="Stretch"
                             ItemsSource="{Binding SelectedProfile.EditorActions}"
                             controls:ListBoxDragDrop.DragKind="Action"
                             controls:ListBoxDragDrop.AcceptKinds="Action"
                             controls:ListBoxDragDrop.DropCommand="{Binding ReorderDropCommand}"
                             controls:ListBoxDragDrop.TargetParentId="{Binding SelectedProfile.Id}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             PreviewMouseWheel="ActionList_OnPreviewMouseWheel"
                             PreviewKeyDown="ActionList_OnPreviewKeyDown"
                             RequestBringIntoView="ActionList_OnRequestBringIntoView"
                             SelectedItem="{Binding SelectedAction, Mode=TwoWay}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Margin" Value="{DynamicResource ActionCardItemMargin}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                <Border Margin="0,14,0,5" Padding="0,12,0,8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPostRestoreSectionStart}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}"
                                                   Text="{DynamicResource Editor.PostRestoreActions}" />
                                        <Button Grid.Column="1" Margin="12,0,0,0"
                                                Command="{Binding DataContext.TogglePostRestoreActionPickerCommand, Source={x:Reference Root}}"
                                                Click="PostRestoreActionPicker_OnClick"
                                                Content="{DynamicResource Editor.AddAction}" />
                                    </Grid>
                                </Border>
                                <Grid>
                                    <controls:CardSurfaceControl>
                                        <controls:CardSurfaceControl.Style>
                                            <Style TargetType="{x:Type controls:CardSurfaceControl}" BasedOn="{StaticResource ActionCardSurfaceStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsComment}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:CardSurfaceControl.Style>
                                    </controls:CardSurfaceControl>
                                    <Border Padding="{DynamicResource ActionCardPadding}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="11">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsComment}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                             <StackPanel>
                                             <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Margin="0,0,13,0"
                                                      IsChecked="{Binding IsEnabled}"
                                                      ToolTip="{DynamicResource Tooltip.EnableAction}" />
                                            <Border Grid.Column="1" Width="22" Height="22" Margin="0,0,9,0"
                                                    VerticalAlignment="Center" Background="{DynamicResource InputBackgroundBrush}"
                                                    CornerRadius="5" SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Image Source="{Binding ActionFallbackIcon}" Width="18" Height="18"
                                                           Stretch="Uniform" SnapsToDevicePixels="True">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasApplicationIcon}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <Image Source="{Binding ApplicationIcon}" Width="18" Height="18"
                                                           Stretch="Uniform" SnapsToDevicePixels="True"
                                                           Visibility="{Binding HasApplicationIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>
                                            <Button Grid.Column="2"
                                                    controls:ListBoxDragDrop.IsDragHandle="True"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.ToggleActionExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Click="ActionHeader_OnClick"
                                                    Cursor="Hand"
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    AutomationProperties.ItemStatus="{Binding IsExpanded}"
                                                    ToolTip="{Binding Type}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                        <TextBlock Margin="0,3,0,0" Text="{Binding Summary}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.ShowCardDetails, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                         <TextBlock Margin="0,2,0,0" Text="{Binding CurrentStatusText}"
                                                                    ToolTip="{Binding CurrentStatusTooltip}" TextTrimming="CharacterEllipsis">
                                                             <TextBlock.Style>
                                                                 <Style TargetType="TextBlock">
                                                                     <Setter Property="Visibility" Value="Collapsed" />
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding ShouldShowCurrentStatus}" Value="True">
                                                                             <Setter Property="Visibility" Value="Visible" />
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding DataContext.ShowCardDetails, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                                                                             <Setter Property="Visibility" Value="Collapsed" />
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </TextBlock.Style>
                                                         </TextBlock>
                                                        <TextBlock Margin="0,5,0,0"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding ExecutionStateText}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExecutionRunning}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasExecutionError}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="12,0,5,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="18"
                                                               Foreground="{DynamicResource TextTertiaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#x203A;" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="&#x2304;" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="3" Margin="8,0,0,0"
                                                    Style="{StaticResource CompactIconButton}"
                                                    ToolTip="{DynamicResource Tooltip.MoreOptions}"
                                                    Click="ActionOverflow_OnClick">
                                                <Path Width="4" Height="16" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"
                                                      Data="M8,1 A2,2 0 1 0 8,5 A2,2 0 1 0 8,1 M8,6 A2,2 0 1 0 8,10 A2,2 0 1 0 8,6 M8,11 A2,2 0 1 0 8,15 A2,2 0 1 0 8,11" />
                                                <Button.ContextMenu>
                                                    <ContextMenu Closed="ContextMenu_OnClosed">
                                                        <MenuItem Header="{DynamicResource Editor.TestAction}"
                                                                  Command="{Binding DataContext.TestActionCommand, Source={x:Reference Root}}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="{DynamicResource Editor.DuplicateAction}"
                                                                  Command="{Binding DataContext.DuplicateActionCommand, Source={x:Reference Root}}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="{DynamicResource Editor.UndoActionTest}"
                                                                  Command="{Binding DataContext.UndoSingleActionTestCommand, Source={x:Reference Root}}"
                                                                  IsEnabled="{Binding DataContext.CanUndoSingleActionTest, Source={x:Reference Root}}" />
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Editor.DeleteAction}"
                                                                  Command="{Binding DataContext.DeleteActionCommand, Source={x:Reference Root}}"
                                                                  CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource DangerBrush}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>

                                        <TextBlock Margin="62,6,0,0" Foreground="{DynamicResource DangerBrush}"
                                                   Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ValidationLevel}" Value="Valid"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ValidationLevel}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Margin="62,13,0,0"
                                                Padding="13"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                CornerRadius="9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                    <Setter Property="MaxHeight" Value="0" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="IsHitTestVisible" Value="True" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="1"
                                                                                         Duration="0:0:0.16" />
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                         From="0"
                                                                                         To="1800"
                                                                                         Duration="0:0:0.16">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="0"
                                                                                         Duration="0:0:0.14" />
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                         From="1800"
                                                                                         To="0"
                                                                                         Duration="0:0:0.14">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseIn" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                             <StackPanel>
                                             <editors:ActionNameEditor />
                                             <Grid>
                                                <editors:ProgramActionEditor />
                                                <editors:SystemActionEditor />
                                                <editors:ProcessActionEditor />
                                              <editors:AutomationActionEditor />
                                            </Grid>
                                            <Button Margin="0,13,0,0" Padding="0" HorizontalAlignment="Left"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding DataContext.ToggleAdvancedOptionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="›"/><Style.Triggers><DataTrigger Binding="{Binding IsAdvancedOptionsExpanded}" Value="True"><Setter Property="Text" Value="⌄"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource ActionEditor.AdvancedOptions}" />
                                                </StackPanel>
                                            </Button>
                                             <Border Margin="0,8,0,0" Padding="12" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="7">
                                                 <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAdvancedOptionsExpanded}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                  <StackPanel>
                                                      <editors:ActionAdvancedOptionsEditor
                                                          CommandHost="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionEditorControl}}}" />
                                                  </StackPanel>
                                             </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                        </Border>

                                    <Border Margin="0,1" Padding="10,5" Background="Transparent" CornerRadius="7">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsComment}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Padding="0"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding DataContext.ToggleActionExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Click="ActionHeader_OnClick"
                                                        Cursor="Hand"
                                                        controls:ListBoxDragDrop.IsDragHandle="True"
                                                        AutomationProperties.Name="{Binding DisplayName}"
                                                        ToolTip="{Binding Type}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding ActionFallbackIcon}" Width="16" Height="16"
                                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                                               Stretch="Uniform" SnapsToDevicePixels="True" />
                                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1" Margin="8,0,0,0"
                                                        Style="{StaticResource CompactIconButton}"
                                                        ToolTip="{DynamicResource Tooltip.MoreOptions}"
                                                        Click="ActionOverflow_OnClick">
                                                    <Path Width="4" Height="16" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"
                                                          Data="M8,1 A2,2 0 1 0 8,5 A2,2 0 1 0 8,1 M8,6 A2,2 0 1 0 8,10 A2,2 0 1 0 8,6 M8,11 A2,2 0 1 0 8,15 A2,2 0 1 0 8,11" />
                                                    <Button.ContextMenu>
                                                        <ContextMenu Closed="ContextMenu_OnClosed">
                                                            <MenuItem Header="{DynamicResource Editor.DuplicateAction}"
                                                                      Command="{Binding DataContext.DuplicateActionCommand, Source={x:Reference Root}}"
                                                                      CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="{DynamicResource Editor.DeleteAction}"
                                                                      Command="{Binding DataContext.DeleteActionCommand, Source={x:Reference Root}}"
                                                                      CommandParameter="{Binding}"
                                                                      Foreground="{DynamicResource DangerBrush}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>
                                            <Border Margin="0,7,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <editors:CommentActionEditor />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile.EditorActions.Count, Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="28"
                                   Foreground="{DynamicResource IconMuted}"
                                   Text="＋" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Empty.NoActions}" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{DynamicResource Empty.NoActionsHint}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="6" Margin="0,10,0,0" Padding="0,12,0,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProfile.PostRestoreActions.Count, Mode=OneWay}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}"
                                   Text="{DynamicResource Editor.PostRestoreActions}" />
                        <Button Grid.Column="1" Margin="12,0,0,0"
                                Command="{Binding TogglePostRestoreActionPickerCommand}"
                                Click="PostRestoreActionPicker_OnClick"
                                Content="{DynamicResource Editor.AddAction}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="8" Margin="0,6,24,0" VerticalAlignment="Stretch"
                      Visibility="{Binding HasExecutionStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Height="30" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!-- Keep the cancel-button slot reserved after execution so the status
                                 text has identical horizontal and vertical geometry in every state. -->
                            <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ExecutionErrorMessage}">
                            <Run Text="[" />
                            <Run Text="{Binding CurrentExecutionActionNumber, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding TotalExecutionActions, Mode=OneWay}" />
                            <Run Text="] " />
                            <Run Text="{Binding CurrentExecutionActionName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  •  " />
                            <Run Text="{DynamicResource Execution.StatusPrefix}" />
                            <Run Text=" " />
                            <Run Text="{Binding ExecutionStatusText, Mode=OneWay}" />
                        </TextBlock>
                        <Button Grid.Column="1"
                                Margin="10,0,0,0"
                                Width="78" Height="30" Padding="8,4"
                                VerticalAlignment="Center"
                                Command="{Binding CancelProfileCommand}"
                                Visibility="{Binding IsCancellationAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Content="{DynamicResource Execution.Cancel}" />
                    </Grid>
                </Grid>

                <Border Grid.Row="7" Height="1" Margin="0"
                        Background="{DynamicResource BorderBrush}" />

            </Grid>
        </Grid>
    </ContentControl>
</UserControl>
