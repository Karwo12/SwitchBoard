                                                          <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource ActionEditor.Arguments}"/><TextBlock Margin="5,0,0,0" Style="{StaticResource CaptionText}" Text="ⓘ" ToolTip="{DynamicResource ActionEditor.ArgumentsHelp}"/></StackPanel><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><TextBox Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource ActionEditor.ArgumentsHelp}"/><Button Grid.Column="1" Margin="6,0,0,0" Content="{DynamicResource ActionEditor.SelectArguments}" Command="{Binding DataContext.SelectArgumentsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></Grid></Border>
                                                          <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.InstanceBehavior}" ToolTip="{DynamicResource Advanced.InstanceBehavior}"/><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableInstanceBehaviors}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding InstanceBehavior}" /></Grid></Border>
                                                          <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.RunAsAdministrator}" ToolTip="{DynamicResource ActionEditor.RunAsAdministrator}"/><CheckBox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding RunAsAdministrator}" /></Grid></Border>
                                                          <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.UseCustomWorkingDirectory}" ToolTip="{DynamicResource Advanced.UseCustomWorkingDirectoryHelp}"/><CheckBox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding UseCustomWorkingDirectory}" /></Grid></Border>
                                                          <Border Margin="0,4,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource SettingsRowBorderStyle}"><Setter Property="BorderThickness" Value="0"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UseCustomWorkingDirectory}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.WorkingDirectory}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><TextBox Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding WorkingDirectory}"/><Button Grid.Column="1" Margin="6,0,0,0" Content="{DynamicResource ActionEditor.Browse}" Command="{Binding DataContext.BrowseWorkingDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></Grid></Grid></Border>
                                                      </StackPanel>
                                                      <StackPanel Margin="0,8,0,0">
                                                         <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="program.run"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                         <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource Advanced.ProgramWindow}" />
                                                          <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.WindowBehavior}" ToolTip="{DynamicResource Advanced.WindowBehavior}"/><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableWindowBehaviors}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding WindowBehavior}" /></Grid></Border>
                                                          <Border Margin="0,4,0,0" Padding="10,7" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"><Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="0"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsWindowWaitEnabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.WindowWait}"/><TextBox Grid.Column="1" Text="{Binding WindowWaitSeconds}" /></Grid></Border>
                                                     </StackPanel>
                                                     <StackPanel Margin="0,8,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="program.run"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                         <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource Advanced.RetryAndErrors}" />
                                                          <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.RetryEnabled}" ToolTip="{DynamicResource Advanced.RetryEnabled}"/><CheckBox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding RetryOnFailure}" /></Grid></Border>
                                                          <Border Margin="0,4,0,0" Padding="10,7" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"><Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="0"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RetryOnFailure}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.MaximumAttempts}"/><TextBox Grid.Column="1" Text="{Binding MaximumAttempts}" /></Grid></Border>
                                                          <Border Margin="0,4,0,0" Padding="10,7" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"><Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="0"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RetryOnFailure}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource Advanced.RetryDelay}"/><TextBox Grid.Column="1" Text="{Binding RetryDelaySeconds}" /></Grid></Border>
                                                          <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.OnFailure}" ToolTip="{DynamicResource ActionEditor.OnFailure}"/><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFailurePolicies}" DisplayMemberPath="DisplayName" SelectedValue="{Binding FailurePolicyId, Mode=TwoWay}" SelectedValuePath="Value" /></Grid></Border>
                                                     </StackPanel>
                                                     <StackPanel Margin="0,8,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="program.run"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                         <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource Advanced.Restoring}" ToolTip="{DynamicResource ActionEditor.RestoreBehavior}" />
                                                          <Border Style="{StaticResource SettingsRowBorderStyle}" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{DynamicResource ActionEditor.RestoreBehavior}"/><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableRestoreBehaviors}" DisplayMemberPath="DisplayName" SelectedValue="{Binding RestoreBehaviorId, Mode=TwoWay}" SelectedValuePath="Value" /></Grid></Border>
                                                     </StackPanel>
                                                     <StackPanel Margin="0,11,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SupportsRestore}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="program.run">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}"
                                                                   Text="{DynamicResource ActionEditor.RestoreBehavior}" />
                                                        <ComboBox ItemsSource="{Binding AvailableRestoreBehaviors}" DisplayMemberPath="DisplayName"
                                                                  SelectedValue="{Binding RestoreBehaviorId, Mode=TwoWay}" SelectedValuePath="Value" />
                                                        <StackPanel Margin="0,11,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsRestoreScriptEnabled}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Margin="0,0,0,9" Style="{StaticResource CaptionText}"
                                                                       Text="{DynamicResource RestoreScript.Help}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource RestoreScript.Path}" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding RestoreScriptPath, UpdateSourceTrigger=PropertyChanged}" />
                                                                <Button Grid.Column="2" Command="{Binding DataContext.BrowseRestoreScriptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.Browse}" />
                                                            </Grid>
                                                            <Grid Margin="0,11,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <StackPanel><TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.Arguments}"/><TextBox Text="{Binding RestoreScriptArguments, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.WorkingDirectory}"/><TextBox Text="{Binding RestoreScriptWorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                            </Grid>
                                                            <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.ScriptType}" />
                                                            <ComboBox ItemsSource="{Binding AvailableScriptTypes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding RestoreScriptType}" />
                                                            <CheckBox Margin="0,10,0,0" IsChecked="{Binding RestoreScriptWaitForExit}" Content="{DynamicResource RestoreScript.Wait}" />
                                                            <CheckBox Margin="0,7,0,0" IsChecked="{Binding RestoreScriptRunAsAdministrator}" Content="{DynamicResource ActionEditor.RunAsAdministrator}" />
                                                            <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.Timeout}" />
                                                            <TextBox Text="{Binding RestoreScriptTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                     </StackPanel>
                                                     </StackPanel>
                                                 </StackPanel>
                                             </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile.Actions.Count, Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="28"
                                   Foreground="{DynamicResource IconMuted}"
                                   Text="＋" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Empty.NoActions}" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{DynamicResource Empty.NoActionsHint}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="7" Margin="0,6,24,0" VerticalAlignment="Stretch"
                      Visibility="{Binding HasExecutionStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Height="30" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!-- Keep the cancel-button slot reserved after execution so the status
                                 text has identical horizontal and vertical geometry in every state. -->
                            <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ExecutionErrorMessage}">
                            <Run Text="[" />
                            <Run Text="{Binding CurrentExecutionActionNumber, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding TotalExecutionActions, Mode=OneWay}" />
                            <Run Text="] " />
                            <Run Text="{Binding CurrentExecutionActionName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  •  " />
                            <Run Text="{DynamicResource Execution.StatusPrefix}" />
                            <Run Text=" " />
                            <Run Text="{Binding ExecutionStatusText, Mode=OneWay}" />
                        </TextBlock>
                        <Button Grid.Column="1"
                                Margin="10,0,0,0"
                                Width="78" Height="30" Padding="8,4"
                                VerticalAlignment="Center"
                                Command="{Binding CancelProfileCommand}"
                                Visibility="{Binding IsCancellationAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Content="{DynamicResource Execution.Cancel}" />
                    </Grid>
                </Grid>

                <Border Grid.Row="6" Height="1" Margin="0"
                        Background="{DynamicResource BorderBrush}" />

            </Grid>
        </Grid>
    </ContentControl>
</UserControl>
