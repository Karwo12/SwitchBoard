<UserControl x:Class="SwitchBoard.Controls.ActionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwitchBoard.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="700">
    <ContentControl Padding="24,22,24,68" Background="{DynamicResource ProfileEditorSurfaceBrush}"
                    Style="{StaticResource GlassPanel}">
        <Grid>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="34"
                           Foreground="{DynamicResource IconMuted}"
                           Text="◇" />
                <TextBlock Margin="0,12,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Empty.SelectProfile}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource CaptionText}"
                           Text="{DynamicResource Empty.SelectProfileHint}" />
            </StackPanel>

            <Grid Visibility="{Binding SelectedProfile, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Panel.ProfileEditor}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{DynamicResource Panel.ProfileEditorSubtitle}" />
                        <TextBlock Margin="0,5,0,0" Text="{Binding RestoreNoticeText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasRestoreNotice}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinWidth="118"
                            Command="{Binding RunProfileCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Setter Property="Tag" Value="{DynamicResource Execution.RunProfile}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfileRunning}" Value="True">
                                        <Setter Property="Tag" Value="{DynamicResource Execution.RunningButton}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Margin="0,0,7,0" Stretch="Uniform" Data="M3,2 L15,8.5 L3,15 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" MinWidth="108" Command="{Binding RestoreProfileCommand}"
                            ToolTip="{Binding RestorePreviewText}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Margin="0,0,7,0" Stretch="Uniform"
                                  Style="{StaticResource SemanticStrokeIcon}"
                                  Data="M5,6 A6,6 0 1 1 4,13 M5,6 H1 M5,6 V2"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding RestoreButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5" Width="30" Height="30" Padding="0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasPendingRestore, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding DiscardPendingRestoreCommand}"
                            Content="×"
                            FontSize="16"
                            ToolTip="{DynamicResource Restore.DiscardTooltip}" />
                    <Button Grid.Column="6" Width="30" Height="30" Padding="0" Margin="4,0,0,0"
                            Command="{Binding RefreshCurrentStatesCommand}"
                            ToolTip="{Binding RefreshButtonTooltip}">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Style="{StaticResource SemanticStrokeIcon}"
                              Data="M16,8 A7,7 0 1 1 13,2 M13,2 H17 M13,2 V6"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Border Grid.Column="7"
                            Padding="10,5"
                            VerticalAlignment="Center"
                            Style="{StaticResource GlassCard}">
                        <TextBlock Style="{StaticResource CaptionText}">
                            <Run Text="{Binding SelectedProfile.Actions.Count, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{DynamicResource Common.ActionsLower}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,7"
                                   Style="{StaticResource EyebrowText}"
                                   Text="{DynamicResource Editor.NewActionType}" />
                        <ComboBox ItemsSource="{Binding AvailableActionTypes}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedActionType}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            MinWidth="116"
                            Margin="0,21,0,0"
                            Command="{Binding AddActionCommand}"
                            Content="{DynamicResource Editor.AddAction}" />
                </Grid>

                <Grid Grid.Row="4">
                    <ListBox x:Name="ActionList"
                             ItemsSource="{Binding SelectedProfile.Actions}"
                             controls:ListBoxDragDrop.DragKind="Action"
                             controls:ListBoxDragDrop.AcceptKinds="Action"
                             controls:ListBoxDragDrop.DropCommand="{Binding ReorderDropCommand}"
                             controls:ListBoxDragDrop.TargetParentId="{Binding SelectedProfile.Id}"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="ActionList_OnPreviewMouseWheel"
                             RequestBringIntoView="ActionList_OnRequestBringIntoView"
                             SelectedItem="{Binding SelectedAction, Mode=TwoWay}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" Style="{StaticResource GlassCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Margin="0,0,13,0"
                                                      IsChecked="{Binding IsEnabled}"
                                                      ToolTip="{DynamicResource Tooltip.EnableAction}" />
                                            <Button Grid.Column="1"
                                                    controls:ListBoxDragDrop.IsDragHandle="True"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.ToggleActionExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Click="ActionHeader_OnClick"
                                                    Cursor="Hand"
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    AutomationProperties.ItemStatus="{Binding IsExpanded}"
                                                    ToolTip="{Binding Type}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Text="{Binding Summary}" />
                                                        <TextBlock Margin="0,2,0,0" Text="{Binding CurrentStatusText}"
                                                                   ToolTip="{Binding CurrentStatusTooltip}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="12,0,5,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="18"
                                                               Foreground="{DynamicResource TextTertiaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#x203A;" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="&#x2304;" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DeleteActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#x00D7;"
                                                    ToolTip="{DynamicResource Tooltip.RemoveAction}"
                                                    Style="{StaticResource DangerIconButton}" />
                                        </Grid>

                                        <TextBlock Margin="31,6,0,0" Foreground="{DynamicResource DangerBrush}"
                                                   Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Margin="31,13,0,0"
                                                Padding="13"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                    <Setter Property="MaxHeight" Value="0" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="IsHitTestVisible" Value="True" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="1"
                                                                                         Duration="0:0:0.16" />
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                         From="0"
                                                                                         To="1800"
                                                                                         Duration="0:0:0.16">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="0"
                                                                                         Duration="0:0:0.14" />
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                                         From="1800"
                                                                                         To="0"
                                                                                         Duration="0:0:0.14">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseIn" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                            <Grid>
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="program.run">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.FriendlyName}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.Target}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="2"
                                                                Command="{Binding DataContext.BrowseProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{DynamicResource ActionEditor.Browse}" />
                                                        <Button Grid.Column="4"
                                                                Command="{Binding DataContext.FindProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{DynamicResource ActionEditor.FindProgram}" />
                                                    </Grid>
                                                    <Grid Margin="0,11,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.Arguments}" />
                                                                <TextBlock Margin="5,0,0,0" Style="{StaticResource CaptionText}" Text="ⓘ">
                                                                    <TextBlock.ToolTip><StackPanel MaxWidth="330"><TextBlock Text="{DynamicResource ActionEditor.ArgumentsHelp}" TextWrapping="Wrap"/><TextBlock Margin="0,5,0,0" Text="{DynamicResource ActionEditor.ArgumentsExample}" TextWrapping="Wrap"/></StackPanel></TextBlock.ToolTip>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.WorkingDirectory}" />
                                                            <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Type}" Value="display.configure"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.FriendlyName}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,11,0,0" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectDisplayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectDisplay}" />
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.SelectedDisplay}" />
                                                    <TextBox Text="{Binding DisplayMonitorName}" IsReadOnly="True" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="{Binding DisplayDeviceId}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayDeviceId}" />
                                                    <Grid Margin="0,11,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel><TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.Resolution}"/><ComboBox ItemsSource="{Binding AvailableDisplayResolutions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedDisplayResolution, Mode=TwoWay}"/></StackPanel>
                                                        <StackPanel Grid.Column="2"><TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.RefreshRate}"/><ComboBox ItemsSource="{Binding AvailableDisplayRefreshRates}" SelectedItem="{Binding DisplayRefreshRate, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} Hz}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                                                    </Grid>
                                                    <TextBlock Margin="0,9,0,0" Style="{StaticResource CaptionText}" Text="{DynamicResource ActionEditor.DisplaySafetyHint}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="process.setState">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.FriendlyName}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,11,0,0"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{DynamicResource ActionEditor.SelectProcess}" />
                                                    <Grid Margin="0,11,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.ProcessName}" />
                                                            <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.ExecutablePath}" />
                                                            <TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.DesiredState}" />
                                                    <ComboBox ItemsSource="{Binding AvailableProcessStates}"
                                                              DisplayMemberPath="DisplayName"
                                                              SelectedValue="{Binding DesiredProcessState, Mode=TwoWay}"
                                                              SelectedValuePath="Value" />
                                                    <TextBlock Margin="0,9,0,0" Style="{StaticResource CaptionText}"
                                                               Text="{DynamicResource ActionEditor.ProcessMultipleHint}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionText}"
                                                               Text="{DynamicResource ActionEditor.AdminHint}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Type}" Value="service.setState"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.FriendlyName}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,11,0,0" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectService}" />
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.SelectedService}" />
                                                    <TextBox Text="{Binding ServiceName}" IsReadOnly="True" />
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.ServiceRuntimeState}" />
                                                    <ComboBox ItemsSource="{Binding AvailableServiceStates}" DisplayMemberPath="DisplayName"
                                                              SelectedValue="{Binding DesiredServiceState, Mode=TwoWay}" SelectedValuePath="Value" />
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.ServiceStartupType}" />
                                                    <ComboBox ItemsSource="{Binding AvailableServiceStartupTypes}" DisplayMemberPath="DisplayName"
                                                              SelectedValue="{Binding DesiredServiceStartupType, Mode=TwoWay}" SelectedValuePath="Value" />
                                                    <TextBlock Margin="0,9,0,0" Style="{StaticResource CaptionText}" Text="{DynamicResource ActionEditor.AdminHint}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Type}" Value="power.setPlan"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.FriendlyName}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,11,0,0" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectPowerPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.SelectPowerPlan}" />
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.SelectedPowerPlan}" />
                                                    <TextBox Text="{Binding PowerPlanName}" IsReadOnly="True" />
                                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionText}" Text="{Binding PowerPlanGuid}" />
                                                </StackPanel>

                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Type}" Value="script.run"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.FriendlyName}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="0,11,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.ScriptPath}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="2" Command="{Binding DataContext.BrowseScriptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Content="{DynamicResource ActionEditor.Browse}" />
                                                    </Grid>
                                                    <Grid Margin="0,11,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Margin="0,0,0,6" Orientation="Horizontal"><TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.Arguments}"/><TextBlock Margin="5,0,0,0" Style="{StaticResource CaptionText}" Text="ⓘ"><TextBlock.ToolTip><StackPanel MaxWidth="330"><TextBlock Text="{DynamicResource ActionEditor.ArgumentsHelp}" TextWrapping="Wrap"/><TextBlock Margin="0,5,0,0" Text="{DynamicResource ActionEditor.ArgumentsExample}" TextWrapping="Wrap"/></StackPanel></TextBlock.ToolTip></TextBlock></StackPanel>
                                                            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2"><TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.WorkingDirectory}" /><TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                    </Grid>
                                                    <StackPanel Margin="0,11,0,0"><TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.ScriptType}" /><ComboBox ItemsSource="{Binding AvailableScriptTypes}" DisplayMemberPath="DisplayName" SelectedValue="{Binding ScriptType, Mode=TwoWay}" SelectedValuePath="Value" /></StackPanel>
                                                    <CheckBox Margin="0,11,0,0" IsChecked="{Binding WaitForScriptExit}" Content="{DynamicResource ActionEditor.WaitForScript}" />
                                                    <CheckBox Margin="0,7,0,0" IsChecked="{Binding RunAsAdministrator}" Content="{DynamicResource ActionEditor.RunAsAdministrator}" />
                                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionText}" Text="{DynamicResource ActionEditor.AdminHint}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="delay">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource EyebrowText}" Text="{DynamicResource ActionEditor.FriendlyName}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
