                                <Run Text="{Binding CurrentExecutionActionName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}">
                                <Run Text="{DynamicResource Execution.StatusPrefix}" />
                                <Run Text=" " />
                                <Run Text="{Binding ExecutionStatusText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="{Binding ExecutionErrorMessage}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding CancelProfileCommand}"
                                Content="{DynamicResource Execution.Cancel}" />
                    </Grid>
                </Border>

                <CheckBox Grid.Row="6"
                          Margin="0,14,0,0"
                          IsChecked="{Binding SelectedProfile.CloseSwitchBoardAfterSuccessfulCompletion, Mode=TwoWay}">
                    <TextBlock Text="{DynamicResource Editor.CloseAfterProfile}"
                               TextWrapping="Wrap" />
                </CheckBox>
            </Grid>
        </Grid>
    </ContentControl>
</UserControl>
