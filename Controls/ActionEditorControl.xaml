<UserControl x:Class="SwitchBoard.Controls.ActionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="700">
    <ContentControl Padding="24,22,24,68" Style="{StaticResource GlassPanel}">
        <Grid>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="34"
                           Foreground="{DynamicResource IconMuted}"
                           Text="◇" />
                <TextBlock Margin="0,12,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Empty.SelectProfile}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource CaptionText}"
                           Text="{DynamicResource Empty.SelectProfileHint}" />
            </StackPanel>

            <Grid Visibility="{Binding SelectedProfile, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Panel.ProfileEditor}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{DynamicResource Panel.ProfileEditorSubtitle}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="10,5"
                            VerticalAlignment="Center"
                            Style="{StaticResource GlassCard}">
                        <TextBlock Style="{StaticResource CaptionText}">
                            <Run Text="{Binding SelectedProfile.Actions.Count}" />
                            <Run Text=" " />
                            <Run Text="{DynamicResource Common.ActionsLower}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,7"
                                   Style="{StaticResource EyebrowText}"
                                   Text="{DynamicResource Editor.ProfileName}" />
                        <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,7"
                                   Style="{StaticResource EyebrowText}"
                                   Text="{DynamicResource Editor.NewActionType}" />
                        <ComboBox ItemsSource="{Binding AvailableActionTypes}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedActionType}" />
                    </StackPanel>
                    <Button Grid.Column="4"
                            MinWidth="116"
                            Margin="0,21,0,0"
                            Command="{Binding AddActionCommand}"
                            Content="{DynamicResource Editor.AddAction}" />
                </Grid>

                <Grid Grid.Row="4">
                    <ListBox ItemsSource="{Binding SelectedProfile.Actions}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" Style="{StaticResource GlassCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Margin="0,0,13,0"
                                                  IsChecked="{Binding IsEnabled}"
                                                  ToolTip="{DynamicResource Tooltip.EnableAction}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource CaptionText}"
                                                       Text="{Binding Type}" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.MoveActionUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="↑"
                                                ToolTip="{DynamicResource Tooltip.MoveUp}"
                                                Style="{StaticResource GhostIconButton}" />
                                        <Button Grid.Column="3"
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.MoveActionDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="↓"
                                                ToolTip="{DynamicResource Tooltip.MoveDown}"
                                                Style="{StaticResource GhostIconButton}" />
                                        <Button Grid.Column="4"
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.DeleteActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="×"
                                                ToolTip="{DynamicResource Tooltip.RemoveAction}"
                                                Style="{StaticResource DangerIconButton}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile.Actions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="28"
                                   Foreground="{DynamicResource IconMuted}"
                                   Text="＋" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Empty.NoActions}" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{DynamicResource Empty.NoActionsHint}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ContentControl>
</UserControl>
