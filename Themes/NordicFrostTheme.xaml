    <SolidColorBrush x:Key="FocusBrush" Color="#B093B8D0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF8491" />
    <SolidColorBrush x:Key="IconPrimary" Color="#FFD2DAE2" />
    <SolidColorBrush x:Key="IconAccent" Color="#FF8FC5E5" />
