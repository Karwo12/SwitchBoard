    <SolidColorBrush x:Key="TopHighlightBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="BottomEdgeBrush" Color="#380B0E12" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE8EDF2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFACB8C5" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF788797" />
