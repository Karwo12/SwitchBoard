<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFF4F5F7" />
        <GradientStop Offset="0.55" Color="#FFE9EBEE" />
        <GradientStop Offset="1" Color="#FFDEE1E5" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FAFFFFFF" />
        <GradientStop Offset="1" Color="#F1F1F3F5" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ElevatedSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFFFF" />
        <GradientStop Offset="1" Color="#FFF6F7F9" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FCFFFFFF" />
    <SolidColorBrush x:Key="SettingsRowBackgroundBrush" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#260F141B" />
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="#400F141B" />
    <SolidColorBrush x:Key="TopHighlightBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="BottomEdgeBrush" Color="#2410151C" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF17181B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5D6068" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF858990" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF303238" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF16171A" />
    <SolidColorBrush x:Key="PrimaryButtonBackground" Color="#FF303238" />
    <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#FF16171A" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#FF08090A" />
    <SolidColorBrush x:Key="PrimaryButtonDisabledBackground" Color="#FFB8BAC0" />
    <SolidColorBrush x:Key="PrimaryButtonDisabledForeground" Color="#FF24262B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0F12151A" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#1712151A" />
    <SolidColorBrush x:Key="PressedBrush" Color="#1F12151A" />
    <SolidColorBrush x:Key="FocusBrush" Color="#80303238" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFD94253" />
    <SolidColorBrush x:Key="IconPrimary" Color="#FF34363B" />
    <SolidColorBrush x:Key="IconAccent" Color="#FF202226" />
    <SolidColorBrush x:Key="IconMuted" Color="#FF90949B" />
    <Color x:Key="ShadowColor">#36000000</Color>
</ResourceDictionary>
